<Application x:Class="UltimateUpdater.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:UltimateUpdater.Views"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <views:BoolToHiddenVisibilityConverter x:Key="BoolToHiddenVisibility" />
            <views:InverseBooleanConverter x:Key="InverseBool" />
            <views:EmptyToNullConverter x:Key="EmptyToNull" />
            <views:GroupInstallableToVisibilityConverter x:Key="GroupInstallable" />
            <views:CategoryIconConverter x:Key="CategoryIcon" />
            <views:PercentToArcConverter x:Key="PercentToArc" />
            <views:GroupSelectionConverter x:Key="GroupSelection" />
            <views:WideEnoughToVisibilityConverter x:Key="WideEnough" />

            <Style x:Key="TitleBarAppIcon" TargetType="ui:ImageIcon">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="20"/>
                <!-- WPF-UI's title bar gives its icon slot a fixed 16 px height and clips anything taller; the negative margin lets the 20 px icon draw past it. -->
                <Setter Property="Margin" Value="0,-2"/>
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            </Style>

            <!-- Themed row context menu: rounded card surface, flat items with a rounded hover highlight. -->
            <Style x:Key="RowMenuItem" TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Padding" Value="11,7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="3,1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- RowMenuItem's template has no Popup, so it cannot host a submenu; this adds the Popup a submenu needs. -->
            <Style x:Key="RowSubmenuItem" TargetType="MenuItem" BasedOn="{StaticResource RowMenuItem}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid>
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="3,1"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="›" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </Border>
                                <!-- Margin and offsets as on the main menu card, so the shadow is not cut off. -->
                                <Popup x:Name="PART_Popup" Placement="Right" AllowsTransparency="True"
                                       Focusable="False" PopupAnimation="Fade"
                                       HorizontalOffset="-4" VerticalOffset="-11"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}">
                                    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="3" MinWidth="150"
                                            Margin="10,8,10,12">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" Direction="270"/>
                                        </Border.Effect>
                                        <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True"/>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RowContextMenu" TargetType="ContextMenu">
                <!-- Opaque fill, so the menu never shows the rows through it. -->
                <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                <!-- The popup window is exactly the template's size, so the card carries a margin as wide as its shadow; the negative offsets give it back. -->
                <Setter Property="HorizontalOffset" Value="-10"/>
                <Setter Property="VerticalOffset" Value="-8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border x:Name="MenuCard" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="7" Padding="3" MinWidth="180" Margin="10,8,10,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" Direction="270"/>
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Every other menu in the app takes the row menu's look through these implicit styles. This template also carries check marks, shortcut text and submenu arrow and popup. -->
            <Style TargetType="ContextMenu" BasedOn="{StaticResource RowContextMenu}"/>
            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Padding" Value="11,7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid>
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="3,1"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuCheck"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuArrow"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Hidden, not collapsed, on an unchecked item so the labels stay in one line; the columns share their width across the menu. -->
                                        <ui:SymbolIcon x:Name="Check" Grid.Column="0" Symbol="Checkmark16" FontSize="14"
                                                       Width="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Visibility="Collapsed"/>
                                        <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                                          RecognizesAccessKey="True"/>
                                        <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                                   Margin="24,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="Arrow" Grid.Column="3" Text="›" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" Visibility="Collapsed"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </Border>
                                <!-- Margin and offsets as on the main menu card, so the shadow is not cut off. -->
                                <Popup x:Name="PART_Popup" Placement="Right" AllowsTransparency="True"
                                       Focusable="False" PopupAnimation="Fade"
                                       HorizontalOffset="-4" VerticalOffset="-11"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}">
                                    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="3" MinWidth="150"
                                            Margin="10,8,10,12">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" Direction="270"/>
                                        </Border.Effect>
                                        <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True"/>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsCheckable" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Hidden"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="InputGestureText" Value="">
                                    <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="HasItems" Value="True">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Margin="8,4" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The shared tone for a standalone panel surface (hint banner, main table, cleanup targets card, settings card, history list). Windows with their own local style derive from it with BasedOn. -->
            <Style x:Key="PanelSurfaceBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <!-- The dark theme's glass top highlight (Views/GlassCardHighlight.cs); transparent in every other theme. -->
                <Setter Property="views:GlassCardHighlight.Show" Value="True"/>
            </Style>

            <!-- The main table's column widths, shared by the header row and every row template that uses this lane layout. -->
            <GridLength x:Key="ColWidthCheck">44</GridLength>
            <GridLength x:Key="ColWidthIcon">36</GridLength>
            <GridLength x:Key="ColWidthDate">104</GridLength>
            <GridLength x:Key="ColWidthVersion">168</GridLength>
            <GridLength x:Key="ColWidthSize">96</GridLength>
            <GridLength x:Key="ColWidthAction">176</GridLength>
            <!-- Publisher: hideable through the column chooser, a trailing column so showing or hiding it never shifts the others. ApplyMainColumnWidths overwrites this at runtime; the literal is the pre-construction fallback. -->
            <GridLength x:Key="ColWidthPublisher">120</GridLength>

            <!-- HistoryWindow's column widths, shared by the header grid and the row template. -->
            <GridLength x:Key="HistoryColWidthWhen">130</GridLength>
            <GridLength x:Key="HistoryColWidthSource">110</GridLength>
            <GridLength x:Key="HistoryColWidthVersion">170</GridLength>
            <!-- The version lane's two number columns and the fixed arrow cell between them, mirroring the main table's 62/14/62 lane. -->
            <GridLength x:Key="HistoryVersionColWidthNumber">62</GridLength>
            <GridLength x:Key="HistoryVersionColWidthArrow">14</GridLength>
            <GridLength x:Key="HistoryColWidthSize">90</GridLength>
            <GridLength x:Key="HistoryColWidthResult">110</GridLength>
            <!-- Fixed rather than Auto: an Auto column sizes per Grid instance, so a visible details button on one row would shift that row's columns out of step. -->
            <GridLength x:Key="HistoryColWidthDetails">28</GridLength>

            <!-- WPF-UI's ui:Button declares its own PressedForeground, defaulting to black, which the pressed trigger writes onto the label and icon in every theme. Setting it fixes that. DynamicResource so a changed accent follows. -->
            <!-- BasedOn names WPF-UI's keyed base style (DefaultUiButtonStyle), not "{x:Type ui:Button}": deriving from the implicit style of the very type is a self-reference that WPF resolves to nothing. -->
            <Style x:Key="PressedForegroundFix" TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource DefaultUiButtonStyle}">
                <!-- A themed brush, not a binding to the button's own Foreground: sharing one WPF-UI brush instance with a second property breaks its deferred Color lookup (NullReferenceException in SolidColorBrush.get_Color). DynamicResource so a theme change follows. -->
                <!-- WPF-UI's pressed template trigger writes black and cannot be outvoted by a style setter, only by a local value; see ButtonLabelColour. The PressedForeground setter below is the second line of defence. -->
                <Setter Property="views:ButtonLabelColour.Keep" Value="True" />
                <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Style.Triggers>
                    <!-- An accent-filled button keeps its on-accent label while pressed; other filled appearances already carry the primary text colour. -->
                    <Trigger Property="Appearance" Value="Primary">
                        <!-- AccentButtonForeground is the brush the button already uses unpressed. -->
                        <Setter Property="PressedForeground" Value="{DynamicResource AccentButtonForeground}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource PressedForegroundFix}" />

            <!-- The window buttons' hover state is added in code (App.AddTitleBarHover): WPF-UI keys no base style for TitleBarButton, so XAML cannot derive from it without the self-reference trap above. -->

            <!-- App-wide scrollbar: a solid, opaque 14 px gutter so content ends to its left and never draws under icons in the last column. Rounded thumb, no up/down buttons. Implicit by type so every ScrollViewer picks it up. -->
            <!-- The thumb's minimum length is not a Thumb MinHeight/MinWidth (the Track ignores those): it takes half of VerticalScrollBarButtonHeight / HorizontalScrollBarButtonWidth, so the Track in the template overrides those keys with 96 for a 48 point floor. -->
            <Style x:Key="AppScrollThumb" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border CornerRadius="3" Margin="3,2"
                                    Background="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Digit columns (sizes, dates, percentages, exit codes): tabular figures keep numbers lined up. A Style rather than a converter so each TextBlock keeps its other properties; "Segoe UI" is the fallback without the variable font. -->
            <Style x:Key="TabularNumberText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            </Style>

            <!-- Fallback only: ThemeService always writes the real value before any window shows. Declared so a card's DynamicResource lookup never comes up empty. -->
            <SolidColorBrush x:Key="GlassTopHighlightBrush" Color="Transparent"/>

            <!-- Fallback only, like GlassTopHighlightBrush: ThemeService writes the real value while Windows high contrast is on. Transparent elsewhere. -->
            <SolidColorBrush x:Key="HighContrastToggleBorderBrush" Color="Transparent"/>

            <!-- A filter/toggle that reads as a pill button, not a checkbox: pressed = accent fill. Shared by the history filters and the Settings sources list. -->
            <Style x:Key="FilterChip" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Padding" Value="11,5"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" CornerRadius="13" Padding="{TemplateBinding Padding}"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush"
                                            Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Width" Value="14"/>
                <Setter Property="MinWidth" Value="14"/>
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1,0,0,0">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Resources>
                                        <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">96</sys:Double>
                                        <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">96</sys:Double>
                                    </Track.Resources>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"
                                                      Opacity="0" Background="Transparent" BorderThickness="0"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource AppScrollThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"
                                                      Opacity="0" Background="Transparent" BorderThickness="0"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
