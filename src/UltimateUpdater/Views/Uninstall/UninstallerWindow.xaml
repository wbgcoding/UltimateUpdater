<ui:FluentWindow x:Class="UltimateUpdater.Views.Uninstall.UninstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:behaviors="clr-namespace:UltimateUpdater.Views.Behaviors"
        xmlns:cleanup="clr-namespace:UltimateUpdater.Views.Cleanup"
        xmlns:uninstall="clr-namespace:UltimateUpdater.Views.Uninstall"
        Title="{Binding Loc[UninstallerTitle]}"
        Width="1080" Height="760" MinWidth="1000" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The card toggle style, converters and brushes shared with the cleanup window. -->
                <cleanup:CleanupTemplates/>
            </ResourceDictionary.MergedDictionaries>

            <uninstall:SortGlyphConverter x:Key="SortGlyph"/>

            <!-- Column widths shared by the header and every row, so the cells line up. -->
            <GridLength x:Key="CheckColumn">36</GridLength>
            <GridLength x:Key="PublisherColumn">150</GridLength>
            <GridLength x:Key="VersionColumn">92</GridLength>
            <GridLength x:Key="SizeColumn">84</GridLength>
            <GridLength x:Key="InstalledColumn">92</GridLength>
            <GridLength x:Key="MethodColumn">184</GridLength>
            <GridLength x:Key="RiskColumn">96</GridLength>

            <Style x:Key="UninstallSectionCard" TargetType="Expander">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border BorderThickness="0,0,0,1" SnapsToDevicePixels="True" Background="Transparent"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ToggleButton Grid.Row="0" Style="{StaticResource CleanupCardToggle}"
                                                  Content="{TemplateBinding Header}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Border x:Name="Body" Grid.Row="1" Visibility="Collapsed" BorderThickness="0,1,0,0"
                                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                        <ContentPresenter/>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A header cell: a quiet text button that sorts by its column, with the direction glyph. -->
            <Style x:Key="UninstallHeaderButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="UninstallRowItem" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Hit" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Hit" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Hit" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="UninstallRowTemplate">
                <Grid Margin="8,6,8,6" MinHeight="24" Background="Transparent"
                      ToolTip="{Binding UnavailableReason, Converter={StaticResource EmptyToNull}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource CheckColumn}"/>
                        <ColumnDefinition Width="*" MinWidth="160"/>
                        <ColumnDefinition Width="{StaticResource PublisherColumn}"/>
                        <ColumnDefinition Width="{StaticResource VersionColumn}"/>
                        <ColumnDefinition Width="{StaticResource SizeColumn}"/>
                        <ColumnDefinition Width="{StaticResource InstalledColumn}"/>
                        <ColumnDefinition Width="{StaticResource MethodColumn}"/>
                        <ColumnDefinition Width="{StaticResource RiskColumn}"/>
                    </Grid.ColumnDefinitions>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Selectable}" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- The tick is drawn here but clicked on the row (OnRowListMouseDown), so one path serves a click on the box and on the row.
                         A row that cannot be removed shows a lock instead; the row's hover says why. -->
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0"
                              IsHitTestVisible="False" IsTabStop="False" Focusable="False"
                              AutomationProperties.Name="{Binding Name}"
                              Visibility="{Binding Selectable, Converter={StaticResource BoolToHiddenVisibility}}"/>
                    <ui:SymbolIcon Grid.Column="0" Symbol="LockClosed16" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.Name="{Binding UnavailableReason}"
                                   Visibility="{Binding Selectable, Converter={StaticResource InverseBoolToVisibility}}"/>

                    <!-- The name cell: a 20 px icon (the app's own once resolved off the UI thread, else a symbol for the kind of entry) and the text lines. -->
                    <Grid Grid.Column="1" Margin="0,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="20" Height="20" Source="{Binding Icon}" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}"/>
                        <ui:SymbolIcon Grid.Column="0" Symbol="{Binding KindSymbol}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <!-- Launcher and install folder: always for an entry from a launcher and for look-alike names. -->
                            <TextBlock Text="{Binding OriginText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding FolderPath}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding HasOrigin, Converter={StaticResource BoolToVisibility}}"/>
                            <!-- Why a greyed row cannot be removed (a driver a device uses), or that a Steam game's folder is empty. -->
                            <TextBlock Text="{Binding NoteText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding NoteText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding StateText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding StateText}"
                                       Visibility="{Binding ShowsState, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Removed">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Column="2" Text="{Binding Publisher}" FontSize="12" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Publisher, Converter={StaticResource EmptyToNull}}" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Version}" FontSize="12" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Version, Converter={StaticResource EmptyToNull}}" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="4" Text="{Binding SizeText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                               Style="{StaticResource TabularNumberText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="5" Text="{Binding InstalledText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                               Style="{StaticResource TabularNumberText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="6" Text="{Binding MethodText}" FontSize="12" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding MethodText}" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <!-- The risk badge: the cleanup window's dot (green, amber, red) with the level's word; the hover names the reason. -->
                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center"
                                ToolTip="{Binding RiskTooltip}" AutomationProperties.Name="{Binding RiskTooltip}">
                        <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RiskLevel}" Value="Considered">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RiskLevel}" Value="Risky">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding RiskLevelText}" FontSize="12" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}"/>
    </ui:FluentWindow.InputBindings>
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- title bar -->
            <RowDefinition Height="Auto"/>   <!-- search -->
            <RowDefinition Height="*"/>      <!-- table -->
            <RowDefinition Height="Auto"/>   <!-- summary and leftovers -->
            <RowDefinition Height="Auto"/>   <!-- actions -->
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Loc[UninstallerTitle]}" FontSize="16" FontWeight="SemiBold">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Style="{StaticResource TitleBarAppIcon}" Source="pack://application:,,,/UltimateUpdater;component/Assets/icon.png"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24,8,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="SearchBox" Grid.Column="0" MaxWidth="460" HorizontalAlignment="Left" Width="460"
                        PlaceholderText="{Binding Loc[UninstallerSearchPlaceholder]}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{Binding Loc[UninstallerSearchPlaceholder]}"
                        Icon="{ui:SymbolIcon Search24}"/>
            <ui:Button Grid.Column="1" Command="{Binding SelectAllCommand}" Appearance="Secondary" Margin="12,0,0,0"
                       Content="{Binding Loc[UninstallerSelectAll]}"/>
            <ui:Button Grid.Column="2" Command="{Binding ClearSelectionCommand}" Appearance="Secondary" Margin="8,0,0,0"
                       Content="{Binding Loc[UninstallerSelectNone]}"/>
            <ui:Button x:Name="RefreshButton" Grid.Column="3" Command="{Binding ReloadCommand}" Appearance="Secondary" Margin="8,0,0,0"
                       Icon="{ui:SymbolIcon ArrowClockwise24}" Content="{Binding Loc[UninstallerRefresh]}"/>
        </Grid>

        <Border Grid.Row="2" Margin="24,0,24,0" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column headers; the right margin is the scrollbar's column below. -->
                <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <Grid Margin="8,8,22,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource CheckColumn}"/>
                            <ColumnDefinition Width="*" MinWidth="160"/>
                            <ColumnDefinition Width="{StaticResource PublisherColumn}"/>
                            <ColumnDefinition Width="{StaticResource VersionColumn}"/>
                            <ColumnDefinition Width="{StaticResource SizeColumn}"/>
                            <ColumnDefinition Width="{StaticResource InstalledColumn}"/>
                            <ColumnDefinition Width="{StaticResource MethodColumn}"/>
                            <ColumnDefinition Width="{StaticResource RiskColumn}"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Style="{StaticResource UninstallHeaderButton}" Command="{Binding SortByCommand}" CommandParameter="name">
                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                <Run Text="{Binding Loc[UninstallerColName], Mode=OneWay}"/><Run>
                                    <Run.Text>
                                        <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="name" Mode="OneWay">
                                            <Binding Path="SortColumn"/>
                                            <Binding Path="SortDescending"/>
                                        </MultiBinding>
                                    </Run.Text>
                                </Run>
                            </TextBlock>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource UninstallHeaderButton}" Command="{Binding SortByCommand}" CommandParameter="publisher">
                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                <Run Text="{Binding Loc[UninstallerColPublisher], Mode=OneWay}"/><Run>
                                    <Run.Text>
                                        <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="publisher" Mode="OneWay">
                                            <Binding Path="SortColumn"/>
                                            <Binding Path="SortDescending"/>
                                        </MultiBinding>
                                    </Run.Text>
                                </Run>
                            </TextBlock>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource UninstallHeaderButton}" Command="{Binding SortByCommand}" CommandParameter="version">
                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                <Run Text="{Binding Loc[UninstallerColVersion], Mode=OneWay}"/><Run>
                                    <Run.Text>
                                        <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="version" Mode="OneWay">
                                            <Binding Path="SortColumn"/>
                                            <Binding Path="SortDescending"/>
                                        </MultiBinding>
                                    </Run.Text>
                                </Run>
                            </TextBlock>
                        </Button>
                        <Button Grid.Column="4" Style="{StaticResource UninstallHeaderButton}" Command="{Binding SortByCommand}" CommandParameter="size">
                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                <Run Text="{Binding Loc[UninstallerColSize], Mode=OneWay}"/><Run>
                                    <Run.Text>
                                        <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="size" Mode="OneWay">
                                            <Binding Path="SortColumn"/>
                                            <Binding Path="SortDescending"/>
                                        </MultiBinding>
                                    </Run.Text>
                                </Run>
                            </TextBlock>
                        </Button>
                        <Button Grid.Column="5" Style="{StaticResource UninstallHeaderButton}" Command="{Binding SortByCommand}" CommandParameter="installed">
                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                <Run Text="{Binding Loc[UninstallerColInstalled], Mode=OneWay}"/><Run>
                                    <Run.Text>
                                        <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="installed" Mode="OneWay">
                                            <Binding Path="SortColumn"/>
                                            <Binding Path="SortDescending"/>
                                        </MultiBinding>
                                    </Run.Text>
                                </Run>
                            </TextBlock>
                        </Button>
                        <Button Grid.Column="6" Style="{StaticResource UninstallHeaderButton}" Command="{Binding SortByCommand}" CommandParameter="method">
                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                <Run Text="{Binding Loc[UninstallerColMethod], Mode=OneWay}"/><Run>
                                    <Run.Text>
                                        <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="method" Mode="OneWay">
                                            <Binding Path="SortColumn"/>
                                            <Binding Path="SortDescending"/>
                                        </MultiBinding>
                                    </Run.Text>
                                </Run>
                            </TextBlock>
                        </Button>
                        <Button Grid.Column="7" Style="{StaticResource UninstallHeaderButton}" Command="{Binding SortByCommand}" CommandParameter="risk">
                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                <Run Text="{Binding Loc[UninstallerColRisk], Mode=OneWay}"/><Run>
                                    <Run.Text>
                                        <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="risk" Mode="OneWay">
                                            <Binding Path="SortColumn"/>
                                            <Binding Path="SortDescending"/>
                                        </MultiBinding>
                                    </Run.Text>
                                </Run>
                            </TextBlock>
                        </Button>
                    </Grid>
                </Border>

                <!-- Style="{x:Null}": the classic scrollbar reserves its own column instead of floating over the right-hand cells. -->
                <ScrollViewer Grid.Row="1" Style="{x:Null}" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                              behaviors:RoundedClip.Radius="7">
                    <StackPanel>
                        <TextBlock Text="{Binding PreviewNote}" FontSize="12" Margin="12,8,12,4" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding HasPreviewNote, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding Loc[UninstallerLoading]}" FontSize="14" Margin="0,28,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding ShowsLoadingText, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding EmptyText}" FontSize="14" Margin="0,28,0,0" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="420"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding ShowsEmptyText, Converter={StaticResource BoolToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding Sections}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Style="{StaticResource UninstallSectionCard}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <Expander.Header>
                                            <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Expander.Header>
                                        <!-- Several rows can be highlighted (Ctrl, Shift); Space ticks them together. The list never scrolls itself: the card's scrollbar does. -->
                                        <StackPanel>
                                            <ListBox ItemsSource="{Binding Rows}" SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                                                     ItemContainerStyle="{StaticResource UninstallRowItem}"
                                                     ItemTemplate="{StaticResource UninstallRowTemplate}"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     behaviors:BubbleScroll.Enabled="True"
                                                     PreviewKeyDown="OnRowListKeyDown"
                                                     PreviewMouseLeftButtonDown="OnRowListMouseDown"/>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3">
            <!-- The restore point step: running, or which earlier one is used. -->
            <TextBlock x:Name="RestorePointLine" Text="{Binding RestorePointText}" FontSize="12" Margin="24,10,24,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding RestorePointText}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding HasRestorePointText, Converter={StaticResource BoolToVisibility}}"/>

            <!-- The run's one-line summary, from the end of a run on. -->
            <TextBlock x:Name="SummaryLine" Text="{Binding SummaryText}" FontSize="13" FontWeight="SemiBold" Margin="24,12,24,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SummaryText}"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}"/>

            <!-- Said once leftovers went into the quarantine: they can be brought back from the history. -->
            <TextBlock x:Name="RestorableLine" Text="{Binding RestorableText}" FontSize="12" Margin="24,4,24,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding RestorableText}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding LeftoversRestorable, Converter={StaticResource BoolToVisibility}}"/>

            <!-- Said when the removal of leftovers threw, so the unchanged list is not read as a removal that ran. -->
            <TextBlock x:Name="LeftoversFailedLine" Text="{Binding LeftoversFailedText}" FontSize="12" Margin="24,4,24,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding LeftoversFailedText}"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Visibility="{Binding LeftoversFailed, Converter={StaticResource BoolToVisibility}}"/>

            <!-- What the removed programs left behind, per program, to tick off. -->
            <Border x:Name="LeftoversCard" Margin="24,10,24,0" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="{Binding ShowsLeftovers, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,10,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Loc[UninstallerLeftoversHeading]}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanningLeftovers}" Value="True">
                                            <Setter Property="Text" Value="{Binding Loc[UninstallerLeftoversScanning]}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ui:Button x:Name="RemoveLeftoversButton" Grid.Column="1" Command="{Binding RemoveLeftoversCommand}" Appearance="Secondary"
                                   MinWidth="140" Content="{Binding Loc[UninstallerRemoveLeftovers]}"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" Style="{x:Null}" MaxHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  behaviors:RoundedClip.Radius="7">
                        <ItemsControl ItemsSource="{Binding LeftoverGroups}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="16,0,16,8">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,2"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ItemsControl ItemsSource="{Binding Items}" IsTabStop="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="26">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30"/>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="84"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0"
                                                                  AutomationProperties.Name="{Binding Path}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding KindText}" FontSize="12" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Path}" FontSize="12" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Margin="0,0,10,0"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12" VerticalAlignment="Center"
                                                                   Style="{StaticResource TabularNumberText}"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="4" Margin="24,12,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding SelectionText}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Command="{Binding StopCommand}" Appearance="Secondary" MinWidth="96" Margin="0,0,10,0"
                           Content="{Binding Loc[UninstallerStop]}"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                           IsEnabled="{Binding IsStopping, Converter={StaticResource InverseBool}}"/>
                <ui:Button x:Name="UninstallButton" Command="{Binding UninstallSelectedCommand}" Style="{StaticResource DangerButton}" MinWidth="160"
                           ToolTip="{Binding Loc[UninstallerButton]}" AutomationProperties.Name="{Binding Loc[UninstallerButton]}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Delete24" Style="{StaticResource DangerButtonIcon}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="UninstallButtonLabel" Style="{StaticResource DangerButtonLabel}" Text="{Binding Loc[UninstallerButton]}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
