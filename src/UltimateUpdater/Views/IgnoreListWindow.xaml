<ui:FluentWindow x:Class="UltimateUpdater.Views.IgnoreListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Loc[IgnoreListTitle]}"
        Width="480" MinHeight="240" MinWidth="380"
        SizeToContent="Height" MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        FocusManager.FocusedElement="{Binding ElementName=CloseButton}">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- title bar -->
            <RowDefinition Height="*"/>      <!-- entry list or empty state -->
            <RowDefinition Height="Auto"/>   <!-- actions -->
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Loc[IgnoreListTitle]}" FontSize="16" FontWeight="SemiBold">
            <ui:TitleBar.Icon>
                <!-- Assembly-qualified like MainWindow's so it resolves whichever assembly is
                     the entry point -->
                <ui:ImageIcon Source="pack://application:,,,/UltimateUpdater;component/Assets/icon.png"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border Grid.Row="1" Margin="20,4,20,10" BorderThickness="0,1,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
                <ItemsControl ItemsSource="{Binding Entries}" Margin="4,4,4,4"
                              AutomationProperties.Name="{Binding Loc[IgnoreListTitle]}">
                    <!-- Without a name here a screen reader reads each row as its view-model type name. -->
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="16,8,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <!-- IsKnownPackage false = the package is not in the current scan;
                                         the item asked for a note here, but the Copy section gives no
                                         string for it, so this is styled muted/italic instead of adding
                                         invented text (see IgnoreListViewModel's own doc comment). -->
                                    <TextBlock Text="{Binding VersionText}" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKnownPackage}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <ui:Button Grid.Column="1" Appearance="Secondary" Padding="8,4"
                                           VerticalAlignment="Center"
                                           Icon="{ui:SymbolIcon Delete24}"
                                           Command="{Binding RemoveCommand}"
                                           ToolTip="{Binding DataContext.Loc[UnignoreButton], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           AutomationProperties.Name="{Binding DataContext.Loc[UnignoreButton], RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="1" Margin="20,24" HorizontalAlignment="Center"
                   Text="{Binding Loc[IgnoreListEmpty]}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding HasNoEntries, Converter={StaticResource BoolToVisibility}}"/>

        <Grid x:Name="IgnoreListActionRow" Grid.Row="2" Margin="20,12,20,20">
            <ui:Button Command="{Binding RemoveAllCommand}" HorizontalAlignment="Left"
                       Appearance="Secondary"
                       Content="{Binding Loc[IgnoreListRemoveAll]}"
                       Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}"/>
            <ui:Button x:Name="CloseButton" Click="OnCloseClicked" Appearance="Primary" HorizontalAlignment="Right" IsDefault="True"
                       Content="{Binding Loc[InstallProgressClose]}"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
