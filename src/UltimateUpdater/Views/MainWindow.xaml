<ui:FluentWindow x:Class="UltimateUpdater.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:UltimateUpdater.Views"
        xmlns:services="clr-namespace:UltimateUpdater.Services"
        mc:Ignorable="d"
        Title="{Binding Loc[AppTitle]}"
        Height="820" Width="1160"
        MinHeight="640" MinWidth="860"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <!-- Background is set explicitly: Mica is unavailable on Windows 10 and when transparency
         effects are off, and without an opaque themed fallback the surface would not match the
         theme's text colour. -->

    <!-- Every window-level shortcut in one place, driven by the SAME table (Views/KeyboardShortcuts.cs)
         its tooltips and the F1 overview window both read: a KeyBinding for a command the view model
         already exposes binds straight to it, and the two shortcuts with no view model command of their
         own (focusing the search box, opening the overview itself) go through a small RoutedCommand each,
         routed here rather than in the view model since both act on THIS window, not on application state. -->
    <ui:FluentWindow.CommandBindings>
        <CommandBinding Command="{x:Static views:MainWindow.FocusSearchCommand}" Executed="OnFocusSearchExecuted"/>
        <CommandBinding Command="{x:Static views:MainWindow.ShowShortcutsCommand}" Executed="OnShowShortcutsExecuted"/>
    </ui:FluentWindow.CommandBindings>
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}"/>
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding InstallSelectedCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static views:MainWindow.FocusSearchCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ShowCleanupCommand}"/>
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding ShowHistoryCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding ShowSettingsCommand}"/>
        <KeyBinding Key="F1" Command="{x:Static views:MainWindow.ShowShortcutsCommand}"/>
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <!-- One spacing rhythm for the whole window: 8 / 16 / 24. -->
        <Thickness x:Key="PagePadding">24,0,24,0</Thickness>

        <!-- The "hide sources without a tool" toggle above the pill strip. -->
        <views:CountToVisibilityConverter x:Key="CountToVisibility"/>
        <views:ShortcutTooltipConverter x:Key="ShortcutTooltip"/>

        <!-- The sort mark beside a sortable column title: only the active direction, in the accent. Fixed width so the mark appearing or
             changing never nudges the label. -->
        <Style x:Key="SortGlyphText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
        </Style>

        <!-- Same tone as the app-wide "PanelSurfaceBorder" (App.xaml): the updates table sits directly
             under the hint banner above it (both plain Border elements using that shared style, or this
             one derived from it), so the two must always match. -->
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource PanelSurfaceBorder}"/>

        <!-- The available version as a link: accent text, underlined on hover and keyboard focus. The label
             lives in the template (not in the Content) so the triggers below can underline it. Used where a
             row has a changelog to open. -->
        <Style x:Key="VersionLinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource TabularNumberText}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Source pill: a contained chip that is also a toggle. Clicking it switches the source off
             (dimmed) and back on. The bottom margin keeps wrapped rows of pills from touching. -->
        <DataTemplate x:Key="SourcePillTemplate">
            <!-- Error pills open their tooltip fast (150ms vs WPF's ~1000ms default): a "!" pill is
                 exactly when someone wants to know why right now, not after a deliberate pause.
                 Right-click copies the raw reason, MouseRightButtonUp, not a
                 MouseBinding, since InputBindings has no right-click MouseAction. -->
            <Border x:Name="PillBorder" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12" Padding="10,3" Margin="0,0,6,6"
                    HorizontalAlignment="Left" Cursor="Hand"
                    Opacity="{Binding PillOpacity}"
                    ToolTip="{Binding TooltipText}"
                    ToolTipService.InitialShowDelay="150"
                    ToolTipService.ShowDuration="60000"
                    Focusable="True" KeyDown="OnClickTargetKeyDown"
                    MouseRightButtonUp="OnErrorPillRightClick"
                    AutomationProperties.Name="{Binding DisplayName}">
                <!-- A pill whose tool is not on this machine is simply not there, rather than dimmed
                     like a switched-off source; the settings list is where such sources can be revealed. -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static services:ProviderScanState.NotInstalled}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.ToggleSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding SourceId}"/>
                </Border.InputBindings>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center"/>
                    <!-- Wait/running/cancelled/error word; Done says enough with the badge, so this stays
                         empty for it. The error word is red, like every other failure mark. -->
                    <TextBlock Text="{Binding StateText}"
                               FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding HasStateText, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Margin="6,0,0,0" Padding="5,0" CornerRadius="7" MinWidth="18"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding FoundCount}" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                    <!-- Cancels only this one source; a ui:Button marks its own click Handled, so it
                         never also fires the pill's own MouseBinding underneath. -->
                    <ui:Button Margin="5,0,0,0" Padding="2" Appearance="Transparent"
                               Command="{Binding DataContext.CancelSourceScanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               CommandParameter="{Binding SourceId}"
                               ToolTip="{Binding DataContext.Loc[CancelSourceScanTooltip], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               AutomationProperties.Name="{Binding DataContext.Loc[CancelSourceScanTooltip], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               Visibility="{Binding IsCancellable, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="12"/>
                    </ui:Button>
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- Themed row context menu (updates only): rounded card surface, flat items with a rounded
             hover highlight, matching the rest of the app rather than the classic Win32 menu. -->
        <Style x:Key="RowMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="3,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RowMenuItem's own template has no Popup at all (it only ever drew a plain header before now),
             so it cannot host a submenu, reusing it for "Remind me later" would render the header but
             never open the three durations under it. Same themed surface, plus the Popup a submenu needs. -->
        <Style x:Key="RowSubmenuItem" TargetType="MenuItem" BasedOn="{StaticResource RowMenuItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="3,1"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="›" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Right" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}">
                                <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="7" Padding="3" MinWidth="150">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Direction="270"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowContextMenu" TargetType="ContextMenu">
            <!-- An OPAQUE solid fill, not the semi-transparent card brush, so the menu never shows the
                 rows through it. -->
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="3" MinWidth="180">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Direction="270"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared by every row that gets the full action set (main table rows and manual-open rows),
             a ContextMenu is outside the visual tree, so it takes its DataContext from whichever row
             opened it (PlacementTarget.DataContext below), same as the per-Style copies this replaced.
             The Steam sub-row's smaller 3-item menu is deliberately its own, separate ContextMenu. -->
        <ContextMenu x:Key="RowActionsMenu" Style="{StaticResource RowContextMenu}"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Style="{StaticResource RowMenuItem}"
                      Header="{Binding StartHeader}" Command="{Binding StartCommand}"
                      Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibility}}"/>
            <!-- Names what will open (a web page, or the plain word for a
                 launcher); the shared "Open" is the tray menu's and the folder
                 action's and must not be renamed under them. -->
            <MenuItem Style="{StaticResource RowMenuItem}"
                      Header="{Binding OpenTargetHeader}" Command="{Binding OpenCommand}"
                      Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}"/>
            <MenuItem Style="{StaticResource RowMenuItem}"
                      Header="{Binding RetryHeader}" Command="{Binding RetryCommand}"
                      Visibility="{Binding ShowRetryButton, Converter={StaticResource BoolToVisibility}}"/>
            <MenuItem Style="{StaticResource RowMenuItem}"
                      Header="{Binding UninstallHeader}" Command="{Binding UninstallCommand}"
                      Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVisibility}}"/>
            <!-- "back to the previous version", offered only once a successful install on
                 record can actually be undone (ShowDowngradeButton on the row). -->
            <MenuItem Style="{StaticResource RowMenuItem}"
                      Header="{Binding DowngradeHeader}" Command="{Binding DowngradeCommand}"
                      Visibility="{Binding ShowDowngradeButton, Converter={StaticResource BoolToVisibility}}"/>
            <MenuItem Style="{StaticResource RowMenuItem}"
                      Header="{Binding OpenFolderHeader}" Command="{Binding OpenFolderCommand}"
                      Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVisibility}}"/>
            <MenuItem Style="{StaticResource RowMenuItem}"
                      Header="{Binding InfoLinkHeader}" Command="{Binding OpenInfoLinkCommand}"
                      Visibility="{Binding HasInfoLink, Converter={StaticResource BoolToVisibility}}"/>
            <MenuItem Style="{StaticResource RowMenuItem}"
                      Header="{Binding IgnoreHeader}" Command="{Binding IgnoreCommand}"
                      Visibility="{Binding ShowIgnoreVersionEntry, Converter={StaticResource BoolToVisibility}}"/>
            <!-- hidden once the whole package is already ignored, it would say
                 nothing the row is not already doing -->
            <MenuItem Style="{StaticResource RowMenuItem}"
                      Header="{Binding IgnoreAllHeader}" Command="{Binding IgnoreAllVersionsCommand}"
                      Visibility="{Binding ShowIgnoreAllEntry, Converter={StaticResource BoolToVisibility}}"/>
            <MenuItem Style="{StaticResource RowMenuItem}"
                      Header="{Binding IgnoreSimpleHeader}" Command="{Binding IgnoreCommand}"
                      Visibility="{Binding IsManualOnly, Converter={StaticResource BoolToVisibility}}"/>
            <!-- "Remind me later": hidden once the row is already ignored (no snooze concept until
                 un-ignored) or already snoozed (the "show again now" entry below takes over instead). -->
            <MenuItem Style="{StaticResource RowSubmenuItem}" Header="{Binding SnoozeHeader}"
                      Visibility="{Binding ShowSnoozeMenu, Converter={StaticResource BoolToVisibility}}">
                <MenuItem Style="{StaticResource RowMenuItem}"
                          Header="{Binding SnoozeOneDayHeader}" Command="{Binding SnoozeCommand}" CommandParameter="day"/>
                <MenuItem Style="{StaticResource RowMenuItem}"
                          Header="{Binding SnoozeOneWeekHeader}" Command="{Binding SnoozeCommand}" CommandParameter="week"/>
                <MenuItem Style="{StaticResource RowMenuItem}"
                          Header="{Binding SnoozeOneMonthHeader}" Command="{Binding SnoozeCommand}" CommandParameter="month"/>
            </MenuItem>
            <MenuItem Style="{StaticResource RowMenuItem}"
                      Header="{Binding UnsnoozeHeader}" Command="{Binding UnsnoozeCommand}"
                      Visibility="{Binding ShowUnsnoozeEntry, Converter={StaticResource BoolToVisibility}}"/>
            <MenuItem Style="{StaticResource RowMenuItem}"
                      Header="{Binding DetailsHeader}" Command="{Binding ShowErrorDetailCommand}"
                      Visibility="{Binding HasInstallError, Converter={StaticResource BoolToVisibility}}"/>
            <!-- Only for a failure classified as interactively maybe fixable, never for
                 "restart needed" or "no applicable package". -->
            <MenuItem Style="{StaticResource RowMenuItem}"
                      Header="{Binding RetryInteractiveHeader}" Command="{Binding RetryInteractiveCommand}"
                      Visibility="{Binding ShowRetryInteractiveButton, Converter={StaticResource BoolToVisibility}}"/>
            <!-- The only way out of NeedsManualWork, Install/Retry stay hidden until this is used. -->
            <MenuItem Style="{StaticResource RowMenuItem}"
                      Header="{Binding ResetPersistentFailureHeader}" Command="{Binding ResetPersistentFailureCommand}"
                      Visibility="{Binding ShowResetPersistentFailureEntry, Converter={StaticResource BoolToVisibility}}"/>
        </ContextMenu>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- title bar -->
            <RowDefinition Height="Auto"/>   <!-- self-update banner -->
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="Auto"/>   <!-- install/queue band -->
            <RowDefinition Height="Auto"/>   <!-- cache/connection banner -->
            <RowDefinition Height="*"/>      <!-- list -->
            <RowDefinition Height="Auto"/>   <!-- action bar -->
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Loc[AppTitle]}" FontSize="16" FontWeight="SemiBold">
            <ui:TitleBar.Icon>
                <!-- assembly-qualified so it resolves no matter which assembly is the entry point -->
                <ui:ImageIcon Source="pack://application:,,,/UltimateUpdater;component/Assets/icon.png"/>
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <!-- WPF-UI's TitleBar draws its own Title text only when Header is null; setting ANY
                     Header content silently drops the title text, since the Header replaces the whole
                     title area rather than sitting beside it. Confirmed by walking the rendered visual
                     tree: no TextBlock anywhere carried the app name. This TextBlock is the actual name
                     next to the icon; the Title property above is kept only for whatever else might still
                     read it (e.g. an OS-level fallback), not for what is drawn. -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="AppTitleText" Text="{Binding Loc[AppTitle]}" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <StackPanel Grid.Row="1">
        <!-- Self-update offer: a quiet banner, never a modal.
             Built by hand rather than with ui:InfoBar, whose template never presented its Content,
             the banner appeared with its title and its close button, and no way to accept the update. -->
        <Border Margin="24,0,24,8" Padding="14,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8"
                views:GlassCardHighlight.Show="True"
                Visibility="{Binding SelfUpdateAvailable, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="ArrowDownload24" FontSize="18" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <!-- A Grid, not a horizontal StackPanel: that panel hands its children unlimited width, so
                     the ellipsis below could never appear and a long title simply pushed the version out of
                     view. Here the title takes what is left over and trims; the version always fits. -->
                <Grid Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- While a verified download waits for running work, the title says so instead. -->
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Loc[SelfUpdateTitle]}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelfUpdateWaitingForWork}" Value="True">
                                        <Setter Property="Text" Value="{Binding Loc[SelfUpdateWaitingForWork]}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding SelfUpdateVersion}" Margin="8,0,0,0" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </Grid>

                <ui:Button Grid.Column="2" Content="{Binding Loc[SelfUpdateWhatsNew]}" Appearance="Secondary"
                           Margin="0,0,8,0" Command="{Binding ShowSelfUpdateChangelogCommand}"/>

                <!-- The hint only explains the busy case; a click already running the update disables the button too, with nothing to wait for. -->
                <ui:Button Grid.Column="3" Content="{Binding Loc[SelfUpdateInstall]}" Appearance="Primary"
                           Command="{Binding InstallSelfUpdateCommand}"
                           ToolTipService.ShowOnDisabled="True">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                    <Setter Property="ToolTip" Value="{Binding Loc[SelfUpdateBusyHint]}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCleanupRunning}" Value="True">
                                    <Setter Property="ToolTip" Value="{Binding Loc[SelfUpdateBusyHint]}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>

                <ui:Button Grid.Column="4" Appearance="Secondary" Margin="8,0,0,0" Padding="9,6"
                           Command="{Binding DismissSelfUpdateCommand}"
                           ToolTip="{Binding Loc[SelfUpdateDismiss]}"
                           AutomationProperties.Name="{Binding Loc[SelfUpdateDismiss]}">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                </ui:Button>
            </Grid>
        </Border>

        <!-- "Installed, reboot pending" notice after a batch (winget 3010/1641). Information, not a
             failure, the updates did apply. -->
        <Border Margin="24,0,24,8" Padding="14,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8"
                views:GlassCardHighlight.Show="True"
                Visibility="{Binding RebootRequiredNotice, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" Symbol="ArrowClockwise24" FontSize="18" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding RebootInfoText}" Margin="12,0,12,0"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:Button Grid.Column="2" Appearance="Secondary" Padding="9,6"
                           Command="{Binding DismissRebootNoticeCommand}"
                           ToolTip="{Binding Loc[SelfUpdateDismiss]}"
                           AutomationProperties.Name="{Binding Loc[SelfUpdateDismiss]}">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                </ui:Button>
            </Grid>
        </Border>

        <!-- A quiet nudge when the last cleanup was long ago. Same Border style and the same
             hand-built dismiss idea as the two banners above; the x's first click swaps the row for an
             in-place "only this time"/"never again" fork instead of a dialog or a toast. -->
        <Border Margin="24,0,24,8" Padding="14,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8"
                views:GlassCardHighlight.Show="True"
                Visibility="{Binding CleanupReminderVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid Visibility="{Binding CleanupReminderOfferVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Broom24" FontSize="18" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <TextBlock Grid.Column="1" Text="{Binding CleanupReminderText}" Margin="12,0,12,0"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <ui:Button Grid.Column="2" Content="{Binding Loc[CleanupTitle]}" Appearance="Primary"
                               Command="{Binding ShowCleanupCommand}"/>

                    <ui:Button Grid.Column="3" Appearance="Secondary" Margin="8,0,0,0" Padding="9,6"
                               Command="{Binding DismissCleanupReminderCommand}"
                               ToolTip="{Binding Loc[SelfUpdateDismiss]}"
                               AutomationProperties.Name="{Binding Loc[SelfUpdateDismiss]}">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                    </ui:Button>
                </Grid>

                <!-- Asks once, in place: the x's first click gets here instead of a dialog or a toast. -->
                <Grid Visibility="{Binding CleanupReminderAsking, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="1" Content="{Binding Loc[CleanupReminderThisTime]}" Appearance="Secondary"
                               Margin="0,0,8,0" Command="{Binding DismissCleanupReminderOnceCommand}"/>
                    <ui:Button Grid.Column="2" Content="{Binding Loc[CleanupReminderNeverAgain]}" Appearance="Secondary"
                               Command="{Binding DismissCleanupReminderForeverCommand}"/>
                </Grid>
            </Grid>
        </Border>
        </StackPanel>

        <!-- Header: what the app found, and the one action that matters. -->
        <Grid Grid.Row="2" Margin="24,4,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding HeadlineText}"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           TextWrapping="Wrap"/>
                <!-- Wrap before trimming: the German summary runs ~30% longer than the
                     English one, and a column that shrinks with the window would clip a trimmed-only
                     line's end. -->
                <TextBlock Text="{Binding SubheadlineText}" Margin="0,2,0,0"
                           FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SubheadlineText}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <!-- Only the scan progress line lives here; between scans it is empty and must not
                         reserve its margin. -->
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SubheadlineText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar Height="3" Margin="0,8,24,0" HorizontalAlignment="Stretch"
                             Minimum="0" Maximum="{Binding ScanProgressTotal}"
                             Value="{Binding ScanProgressDone, Mode=OneWay}"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- A running scan must always be interruptible. -->
            <ui:Button Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                       Appearance="Secondary" Padding="16,8"
                       Content="{Binding Loc[CancelButton]}"
                       Command="{Binding CancelScanCommand}"
                       Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>

            <ui:Button Grid.Column="2" VerticalAlignment="Center"
                       Appearance="Primary" Padding="16,8"
                       Command="{Binding ScanCommand}"
                       ToolTip="{Binding Loc[ScanButton], Converter={StaticResource ShortcutTooltip}, ConverterParameter=ScanButton}">
                <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Content" Value="{Binding Loc[ScanButton]}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                <Setter Property="Content" Value="{Binding Loc[ScanningButton]}"/>
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
                <!-- The icon itself turns while a scan is running, same idea as the cleanup
                     button's sweeping broom above (RenderTransform, so no layout pass; the storyboard
                     only exists while the trigger holds). Linear, not eased, so a full-speed spin never
                     reads as stuttering. -->
                <ui:Button.Icon>
                    <ui:SymbolIcon x:Name="ScanButtonIcon" Symbol="ArrowSync24" FontSize="16"
                                   RenderTransformOrigin="0.5,0.5">
                        <ui:SymbolIcon.RenderTransform>
                            <RotateTransform x:Name="ScanButtonIconRotate"/>
                        </ui:SymbolIcon.RenderTransform>
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Style.Triggers>
                                    <!-- Scanning AND shown: WPF keeps ticking an animation clock for a window
                                         hidden to the tray, which every background interval scan would run
                                         at 60 fps for nothing. -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsScanning}" Value="True"/>
                                            <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard Name="ScanSpinStory">
                                                <Storyboard Timeline.DesiredFrameRate="60">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="RenderTransform.Angle"
                                                        From="0" To="360" Duration="0:0:1.1"
                                                        RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                        <MultiDataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="ScanSpinStory"/>
                                        </MultiDataTrigger.ExitActions>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <!-- Toolbar: icon actions docked right, search and filters filling the rest. The button block is
             DOCKED, not a Grid column: a Grid column here would starve to zero width next to the search box
             on a narrow window, leaving the buttons clipped off the edge. Docked children always keep their
             full natural size; only the WrapPanel below (the fill child) gives way, wrapping search/switches
             onto a second line on a narrow window instead of anything clipping. Same technique as the
             install strip's Pause/Cancel block below (Grid.Row="4", "InstallStrip"). -->
        <!-- No divider line above the toolbar: the header, the toolbar and the table read as one surface,
             and the extra rule only cut the window in half. Cards keep their own glass highlight. -->
        <Grid Grid.Row="3" Margin="24,0,24,12">
            <DockPanel LastChildFill="True">
                <!-- Bigger secondary buttons with larger icons, one block so they move together. Docked,
                     so they never give way, the search box and switches do instead. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- The button shows the cleaning disk (same body/platter/hub/arm geometry as
                         the cleanup dialog's own centre animation, CleaningDiskGeometries.xaml, minus its
                         sparkles: the disk keeps its animation, no stars) while a cleanup is running
                         in the background: the dialog can be closed mid-run now, and this is what says the
                         run is still going. A plain broom glyph shows otherwise. Both are RenderTransforms,
                         so neither costs a layout pass, and the storyboard only exists while the trigger
                         holds; it respects "reduce motion" (SystemParameters.MinimizeAnimation). -->
                    <ui:Button x:Name="ToolbarCleanupButton" Command="{Binding ShowCleanupCommand}" Appearance="Secondary" Padding="11,8" Margin="0,0,8,0"
                               ToolTip="{Binding Loc[ToolbarCleanupLabel], Converter={StaticResource ShortcutTooltip}, ConverterParameter=CleanupTitle}"
                               AutomationProperties.Name="{Binding Loc[ToolbarCleanupLabel]}">
                        <ui:Button.Resources>
                            <views:InverseBoolToVisibilityConverter x:Key="ToolbarInverseBoolToVisibility"/>
                        </ui:Button.Resources>
                        <!-- ui:Button.Icon only accepts an IconElement (SymbolIcon and similar), so the
                             two-state swap (broom glyph or the animated disk, chosen by IsCleanupRunning)
                             is built as plain Content instead, the same size an Icon slot would take. -->
                        <ui:Button.Content>
                          <StackPanel Orientation="Horizontal">
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <ui:SymbolIcon x:Name="ToolbarCleaningBroom" Symbol="Broom24" FontSize="20"
                                               Visibility="{Binding IsCleanupRunning, Converter={StaticResource ToolbarInverseBoolToVisibility}}"/>
                                <!-- The disk's own drawing (CleaningDiskGeometries's body silhouette) only fills
                                     about three quarters of its 24x24 canvas, so scaled down to the 20x20 icon
                                     slot like the broom it looked smaller than every other toolbar glyph. Drawn
                                     at 30x30 instead, centered, with a negative margin so it spills over the
                                     fixed 20x20 slot into the button's own 11,8 padding while the slot (and so
                                     the button's own outer size) never changes. It stays still: only the light
                                     travels, a size pulse had no room inside the button. -->
                                <Grid x:Name="ToolbarCleaningDisk"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="{Binding IsCleanupRunning, Converter={StaticResource BoolToVisibility}}">
                                    <!-- Same 24x24 geometry as CleaningDiskGeometries.xaml (shared with the
                                         cleanup dialog's own centre drawing), inlined here rather than
                                         merged as a resource: this file's own Resources section is edited
                                         by another lane at the same time, so this block stays entirely
                                         self-contained instead of touching it. -->
                                    <Viewbox Width="30" Height="30" Margin="-5" Stretch="Uniform">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M4.6 2 L19.4 2 A1.6,1.6 0 0 1 21 3.6 L21 20.4 A1.6,1.6 0 0 1 19.4 22 L4.6 22 A1.6,1.6 0 0 1 3 20.4 L3 3.6 A1.6,1.6 0 0 1 4.6 2 Z"
                                                  Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                  Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="0.35"/>
                                            <!-- The travelling light: same body silhouette, shown only through a moving
                                                 gradient mask, exactly the technique the cleanup dialog's own centre
                                                 animation uses (CleanupWindow.xaml, SurfaceLight) so the light can never
                                                 spill past the body's own edge. -->
                                            <Path x:Name="ToolbarCleaningLight"
                                                  Data="M4.6 2 L19.4 2 A1.6,1.6 0 0 1 21 3.6 L21 20.4 A1.6,1.6 0 0 1 19.4 22 L4.6 22 A1.6,1.6 0 0 1 3 20.4 L3 3.6 A1.6,1.6 0 0 1 4.6 2 Z"
                                                  Opacity="0.5" Fill="{DynamicResource AccentFillColorDefaultBrush}">
                                                <Path.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" MappingMode="RelativeToBoundingBox">
                                                        <LinearGradientBrush.RelativeTransform>
                                                            <TranslateTransform x:Name="ToolbarLightSlide" X="-0.75"/>
                                                        </LinearGradientBrush.RelativeTransform>
                                                        <GradientStop Color="Transparent" Offset="0"/>
                                                        <GradientStop Color="White" Offset="0.5"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Path.OpacityMask>
                                            </Path>
                                            <!-- The sweep itself is driven from MainWindow.xaml.cs
                                                 (UpdateCleanupIconSweep), not from a Style trigger here: a
                                                 Storyboard animating a path through a Brush's own
                                                 RelativeTransform (OpacityMask.RelativeTransform.X, two hops
                                                 deep) applied via a Style's implicit target is what a WPF-UI
                                                 render-harness regression traced back to (WindowLayoutTests
                                                 started failing on unrelated windows afterwards); a plain
                                                 BeginAnimation call straight on ToolbarLightSlide, the same
                                                 technique InstallBarFill's own glide already uses, does not
                                                 have that problem. -->
                                            <Path Data="M18.25 11.2 A6.25,6.25 0 1 1 5.75 11.2 A6.25,6.25 0 1 1 18.25 11.2 Z"
                                                  Fill="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                            <Path Data="M18.25 11.2 A6.25,6.25 0 1 1 5.75 11.2 A6.25,6.25 0 1 1 18.25 11.2 Z"
                                                  Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="0.8"/>
                                            <Path Data="M14 11.2 A2,2 0 1 1 10 11.2 A2,2 0 1 1 14 11.2 Z"
                                                  Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <Path Data="M12.75 11.2 A0.75,0.75 0 1 1 11.25 11.2 A0.75,0.75 0 1 1 12.75 11.2 Z"
                                                  Fill="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                            <Path Data="M18.731 16.815 L13.654 11.743 A1,1 0 0 1 12.146 13.057 L16.469 18.785 A1.5,1.5 0 0 1 18.731 16.815 Z"
                                                  Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Grid>
                            <TextBlock Text="{Binding Loc[ToolbarCleanupLabel]}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                          </StackPanel>
                        </ui:Button.Content>
                    </ui:Button>
                    <ui:Button Command="{Binding ShowHistoryCommand}" Appearance="Secondary" Padding="11,8" Margin="0,0,8,0"
                               ToolTip="{Binding Loc[HistoryButton], Converter={StaticResource ShortcutTooltip}, ConverterParameter=HistoryButton}"
                               AutomationProperties.Name="{Binding Loc[HistoryButton]}">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="History24" FontSize="20"/></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Command="{Binding ShowSettingsCommand}" Appearance="Secondary" Padding="11,8"
                               ToolTip="{Binding Loc[SettingsButton], Converter={StaticResource ShortcutTooltip}, ConverterParameter=SettingsButton}"
                               AutomationProperties.Name="{Binding Loc[SettingsButton]}">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Settings24" FontSize="20"/></ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <WrapPanel x:Name="ToolbarWrapPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Delay on the binding: the table is only re-shaped once typing settles, so re-filtering
                         never stutters mid-word. -->
                    <ui:TextBox x:Name="SearchBox" Width="260" Margin="0,0,16,4"
                                PlaceholderText="{Binding Loc[SearchPlaceholder]}"
                                Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=180}"
                                Icon="{ui:SymbolIcon Search24}"
                                ToolTip="{Binding Loc[SearchPlaceholder], Converter={StaticResource ShortcutTooltip}, ConverterParameter=SearchPlaceholder}"
                                AutomationProperties.Name="{Binding Loc[SearchPlaceholder]}"/>

                    <!-- The filter switches (critical only, show ignored, hide entries to open yourself, and
                         the persistent-failure collector while it has something) live in one menu, built like
                         the column chooser (Views/FilterMenu.cs). The label carries how many are on. -->
                    <ui:Button x:Name="FilterButton" Click="OnFilterButtonClick" Margin="0,0,0,4"
                               Appearance="Secondary" Padding="12,7" VerticalAlignment="Center"
                               Content="{Binding FilterButtonText}"
                               AutomationProperties.Name="{Binding FilterButtonText}">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Filter24" FontSize="16"/></ui:Button.Icon>
                    </ui:Button>
                </WrapPanel>
            </DockPanel>
        </Grid>

        <!-- Live install/queue band: current item, its progress and the rest of the queue, its own
             full-width row below the toolbar, so Cleanup/History/Settings and search stay reachable
             throughout a batch. Auto-sized row: zero space taken when not installing. -->
        <Border Grid.Row="4" Margin="24,0,24,12" CornerRadius="10"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- A quiet "something is running here" signal, not a brand colour. -->
                <Border Grid.Column="0" Width="3" Margin="0,4,0,4" CornerRadius="2"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"/>

              <Border Grid.Column="1" Padding="18,7,14,7">
              <StackPanel>
                <!-- The batch's own automatic second attempt, its own visibly separate section
                     once it actually starts; stays up for the rest of this batch, not just the retry. -->
                <TextBlock x:Name="SecondAttemptHeader" Text="{Binding Loc[InstallRetryRound]}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           Margin="0,0,0,4"
                           Visibility="{Binding IsSecondAttemptActive, Converter={StaticResource BoolToVisibility}}"/>
                <!-- The stop button is DOCKED, not a Grid column: a Grid column here would starve to zero
                     width next to the star columns on a narrow window, leaving it clipped off the
                     edge, unreachable. Docked children always keep their full natural size; only
                     the Grid below (the fill child) gives way. -->
                <DockPanel x:Name="InstallStrip" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <ui:Button Command="{Binding CancelInstallCommand}" Appearance="Secondary" Padding="12,5"
                                   Content="{Binding Loc[InstallProgressCancel]}"/>
                    </StackPanel>

                    <!-- Outer Grid is the DockPanel's own fill child; the two panels inside it occupy the
                         same cell and are never visible at once (an exact switch,
                         ShowSingleInstallView/HasMultipleRunning are exact opposites while installing), so
                         nesting them here rather than making either one directly the last DockPanel child
                         is what keeps both getting the DockPanel's "fill the rest" treatment regardless of
                         which one currently is Visible. -->
                    <Grid>
                    <Grid x:Name="InstallStripContent"
                          Visibility="{Binding ShowSingleInstallView, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <!-- Star, not Auto: at the window's 860px minimum the item name is what gives way
                                 first (it trims to an ellipsis), instead of the whole strip clipping. -->
                            <ColumnDefinition Width="*" MinWidth="72" MaxWidth="300"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="InstallStripItemName" Text="{Binding CurrentInstallRow.Name}" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CurrentInstallRow.Name}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <!-- What this one item is actually doing: its source, its exact %, and its own
                                 download figure when the tool reports bytes.
                                 Grid, not a horizontal StackPanel, same StackPanel-measures-
                                 with-infinite-width bug as MainWindow's row-name column / the two dialog
                                 windows: TransferText's own MaxWidth was never enough, because the StackPanel
                                 still laid every child out at its unconstrained desired size and only the
                                 OUTER column clipped the overflow raw, mid-digit, with no ellipsis
                                 ("28,6 / 5" instead of "28,6 / 51,9 MB"). The Auto columns give Source/Percent
                                 their natural width; the trailing * column is what finally hands TransferText
                                 a real bounded width to trim against. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding CurrentInstallRow.SourceDisplay}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding CurrentInstallRow.InstallPercentText}" FontSize="11"
                                           Margin="8,0,0,0" Style="{StaticResource TabularNumberText}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding CurrentInstallRow.TransferText}" FontSize="11" Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding CurrentInstallRow.HasTransfer, Converter={StaticResource BoolToVisibility}}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Overall progress: a hand-drawn bar (track + fill), not a WPF-UI ProgressBar,
                             which recurses when star-measured (as it would be here). The exact overall %
                             sits beside it so the number is never hidden inside the bar. The fill's Width is
                             driven entirely from code-behind (UpdateInstallBarFill) so it can glide instead
                             of jump, a plain Binding here would fight the animation on every tick. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <!-- The track width is fixed and the fill is computed from it, so the two numbers
                                 below MUST stay in step. 160 rather than 260: at 860px the strip has no room for
                                 a wider bar next to the figures, and it clipped. ClipToBounds keeps the shine
                                 sweep (below) from bleeding past the rounded ends while it travels. -->
                            <Border Width="160" Height="6" CornerRadius="3" VerticalAlignment="Center" ClipToBounds="True"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Grid>
                                    <Border x:Name="InstallBarFill" HorizontalAlignment="Left" CornerRadius="3"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            Visibility="{Binding InstallHasRealProgress, Converter={StaticResource BoolToVisibility}}"/>

                                    <!-- No real reading has arrived yet: a wandering shine reads as "still
                                         alive" where a bar stuck dead at 0 would not. -->
                                    <!-- The accent colour faded in and out by an opacity mask: a white
                                         gradient vanished on the light theme's near-white track, and a
                                         GradientStop colour cannot take the theme brush as a resource key. -->
                                    <Border x:Name="InstallBarShine" Width="56" Height="6" CornerRadius="3" HorizontalAlignment="Left"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00000000" Offset="0"/>
                                                <GradientStop Color="#99000000" Offset="0.5"/>
                                                <GradientStop Color="#00000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="InstallBarShineTransform"/>
                                        </Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <!-- Both conditions, not just InstallHasRealProgress: that one alone
                                                         is also False whenever the batch is empty, i.e. whenever nothing
                                                         is installing at all, which used to leave this storyboard running
                                                         forever in the background (a data trigger inside a Collapsed
                                                         strip still fires; the sweep kept animating at 60fps with the
                                                         window just sitting idle). -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding InstallHasRealProgress}" Value="False"/>
                                                            <Condition Binding="{Binding IsInstalling}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                    <!-- The sweep itself also needs the window shown: an install that keeps
                                                         running while the window is hidden to the tray would otherwise tick
                                                         this storyboard at 60fps for nothing. A trigger of its own, so the
                                                         strip's visibility above never depends on an ancestor window. -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding InstallHasRealProgress}" Value="False"/>
                                                            <Condition Binding="{Binding IsInstalling}" Value="True"/>
                                                            <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <MultiDataTrigger.EnterActions>
                                                            <BeginStoryboard Name="InstallBarShineStory">
                                                                <Storyboard Timeline.DesiredFrameRate="60">
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="RenderTransform.X"
                                                                        From="-56" To="160" Duration="0:0:1.1"
                                                                        RepeatBehavior="Forever">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <SineEase EasingMode="EaseInOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </MultiDataTrigger.EnterActions>
                                                        <MultiDataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="InstallBarShineStory"/>
                                                        </MultiDataTrigger.ExitActions>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding InstallOverallPercentText}" FontSize="12" Margin="10,0,0,0"
                                       MinWidth="34" TextAlignment="Right" VerticalAlignment="Center"
                                       Style="{StaticResource TabularNumberText}"
                                       Visibility="{Binding ActualWidth, ElementName=InstallStrip,
                                                    Converter={StaticResource WideEnough}, ConverterParameter=400}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- The version being installed TO, and its release date where the source knows one
                            , shown even for a single queued item, never gated on batch size. -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0"
                                    Visibility="{Binding CurrentInstallRow.HasVersions, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="140"
                                       Style="{StaticResource TabularNumberText}"
                                       ToolTip="{Binding CurrentInstallRow.AvailableVersion}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="→ "/><Run Text="{Binding CurrentInstallRow.AvailableVersion, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding CurrentInstallRow.PublishDateText}" FontSize="11"
                                       Style="{StaticResource TabularNumberText}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding CurrentInstallRow.HasPublishDate, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding InstallCountText}" FontSize="12" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <!-- Top-left: total size. Below it: downloaded so far. To ITS right: current
                                 speed (a deliberate layout, not incidental), each line only appears once
                                 it has a real figure. -->
                            <Grid HorizontalAlignment="Right"
                                  Visibility="{Binding ActualWidth, ElementName=InstallStrip,
                                               Converter={StaticResource WideEnough}, ConverterParameter=440}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right"
                                           Text="{Binding InstallTotalSizeText}" FontSize="11"
                                           Visibility="{Binding HasInstallTotalSize, Converter={StaticResource BoolToVisibility}}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"
                                           Text="{Binding InstallDownloadedText}" FontSize="11"
                                           Visibility="{Binding HasInstallDownloaded, Converter={StaticResource BoolToVisibility}}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="6,0,0,0"
                                           Text="{Binding InstallSpeedText}" FontSize="11"
                                           Visibility="{Binding HasInstallSpeed, Converter={StaticResource BoolToVisibility}}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Two or more rows running at once, a compact list instead of the single-row
                         view above, each with its own hand-drawn bar (same reasoning as the single-row bar:
                         a WPF-UI ProgressBar recurses under a star/infinite measure) and its own stop
                         button, reusing UpdateRowViewModel's own StopSingleCommand rather than inventing
                         a second stop mechanism. -->
                    <StackPanel x:Name="InstallStripMultiRunning"
                                Visibility="{Binding HasMultipleRunning, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding InstallRunningCountText}" FontSize="12" FontWeight="Medium"
                                   Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ItemsControl x:Name="RunningRowsList" ItemsSource="{Binding RunningRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="RunningRowCard" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <!-- Star, not Auto, same reason as the single-row name column:
                                                 the name trims before anything else clips. -->
                                            <ColumnDefinition Width="*" MinWidth="60" MaxWidth="220"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="RunningRowName" Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="8,0,0,0">
                                            <TextBlock Text="{Binding InstallPercentText}" FontSize="11" MinWidth="30"
                                                       TextAlignment="Right" Margin="0,0,6,0"
                                                       Style="{StaticResource TabularNumberText}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <Border Width="80" Height="5" CornerRadius="2.5" VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <Border HorizontalAlignment="Left" CornerRadius="2.5"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        Width="{Binding InstallPercent, Converter={StaticResource PercentToWidth}, ConverterParameter=80}"/>
                                            </Border>
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Margin="8,0,0,0" Padding="4,2" Appearance="Secondary"
                                                   Command="{Binding StopSingleCommand}"
                                                   ToolTip="{Binding StopSingleTooltip}"
                                                   AutomationProperties.Name="{Binding StopSingleTooltip}">
                                            <ui:SymbolIcon Symbol="Stop24" FontSize="11" Filled="True"
                                                                         Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                        </ui:Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </Grid>
                </DockPanel>

                <!-- Collapsible queue panel, everything else waiting behind the current item. -->
                <Expander IsExpanded="{Binding IsQueuePanelExpanded}"
                          Background="Transparent" BorderThickness="0" Padding="0" Margin="0,10,0,0"
                          HorizontalContentAlignment="Stretch"
                          Visibility="{Binding HasQueuedRows, Converter={StaticResource BoolToVisibility}}">
                    <Expander.Header>
                        <!-- The whole header row is the hoverable/clickable area, not just the icon+text,
                             a bare StackPanel gave no feedback that this was interactive at all. -->
                        <Border x:Name="QueueHeaderHover" HorizontalAlignment="Stretch" CornerRadius="6" Padding="8,6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="ReOrderDotsVertical24" FontSize="18" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding QueuePanelHeaderText}" FontSize="14" FontWeight="SemiBold"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding QueueTotalSizeText}" FontSize="12"
                                           Style="{StaticResource TabularNumberText}" VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           Visibility="{Binding HasQueueTotalSize, Converter={StaticResource BoolToVisibility}}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </Grid>
                        </Border>
                    </Expander.Header>
                    <!-- Scrolls past a handful of rows instead of pushing the table below it further down,
                         an unbounded queue would otherwise grow the strip without limit. A later change tightened
                         the row card (Margin 0,2 / Padding 12,8), measured in the rendered snapshot at
                         47.3px card height + 4px margin ≈ 51px per row, so 240 now fits 4 full rows (plus
                         a partial 5th) instead of the previous 3; keep this in step if the row template's
                         height changes again. Auto visibility, not a permanent bar, so a short queue shows
                         no scrollbar at all. -->
                    <ScrollViewer x:Name="QueueRowsScroll" VerticalScrollBarVisibility="Auto" MaxHeight="240" Margin="0,6,0,0">
                        <!-- 18px right margin (14px track + 4px air) keeps the auto scrollbar from overlaying
                             the row content, same defect and same fix as EntriesScroll in CleanupWindow.xaml. -->
                        <ItemsControl x:Name="QueueItemsControl" ItemsSource="{Binding QueueRows}" AlternationCount="999" Margin="0,0,18,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- The whole card is the drag source/drop target, reordering and removing
                                     from the queue panel actually changes InstallQueue's own install order,
                                     not just this list. Rounded hover card, same language
                                     as every other row surface in this app (e.g. the Steam child rows),
                                     rather than a flat strip. -->
                                <Border x:Name="QueueRowCard" CornerRadius="10" Margin="0,2" Padding="12,8"
                                        BorderThickness="1" AllowDrop="True" Cursor="SizeAll"
                                        Focusable="True"
                                        AutomationProperties.Name="{Binding Name}"
                                        Loaded="OnQueueRowCardLoaded"
                                        KeyDown="OnQueueRowKeyDown"
                                        MouseLeftButtonDown="OnQueueRowMouseDown"
                                        MouseMove="OnQueueRowMouseMove"
                                        GiveFeedback="OnQueueRowGiveFeedback"
                                        DragOver="OnQueueRowDragOver"
                                        Drop="OnQueueRowDrop">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                            <!-- The hairline only shows on hover/focus, at rest the card reads
                                                 quieter, the same background-only cue every other row surface uses. -->
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                                </Trigger>
                                                <!-- Keyboard-only reachable otherwise: this card is the only
                                                     focusable thing on the row until the remove button (Hidden
                                                     except on hover/focus, see below) reveals itself. -->
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Grip dots, permanent: the row's only "you can reorder this" cue, so visible at rest, not
                                             just on hover/focus (a position number would say nothing a screen
                                             reader can't already read off the automation name below). Tertiary
                                             at rest, secondary on hover or focus. The card's own SizeAll
                                             cursor and Alt+Up/Down (OnQueueRowKeyDown) apply as well. -->
                                        <ui:SymbolIcon x:Name="QueueGripIcon" Grid.Column="0" Symbol="ReOrderDotsVertical24" FontSize="12"
                                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                                       ToolTip="{Binding DataContext.Loc[QueueReorderTooltip],
                                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=QueueRowCard}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=QueueRowCard}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>

                                        <!-- Same tile language as the main table (brand mark / letter / category
                                             glyph), just smaller, a name alone was hard to place at a glance
                                             in a fast-moving queue. -->
                                        <Grid Grid.Column="1" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Border CornerRadius="4" Background="{Binding InitialBrush}"
                                                    Visibility="{Binding UsesTile, Converter={StaticResource BoolToVisibility}}">
                                                <Grid>
                                                    <TextBlock Text="{Binding InitialLetter}" FontSize="11" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TileGlyphBrush}"
                                                               Visibility="{Binding UsesLetterTile, Converter={StaticResource BoolToVisibility}}"/>
                                                    <ui:SymbolIcon Symbol="Box24" FontSize="12" Foreground="{StaticResource TileGlyphBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding UsesGlyphTile, Converter={StaticResource BoolToVisibility}}"/>
                                                    <Path Data="{Binding BrandGeometry}" Fill="{StaticResource TileGlyphBrush}" Stretch="Uniform"
                                                          Width="12" Height="12"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Visibility="{Binding UsesBrandTile, Converter={StaticResource BoolToVisibility}}"/>
                                                </Grid>
                                            </Border>
                                            <Image Source="{Binding Icon}" Width="22" Height="22"/>
                                        </Grid>

                                        <!-- Two lines, name+source on top, everything else compact underneath,
                                             nothing here may wrap (fixed rule for every row surface). -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <!-- Grid, not a horizontal StackPanel: a StackPanel measures its children
                                                 unbounded, so the name never trims and the critical icon is pushed out
                                                 of view at the minimum width. -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="QueueRowName" Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <ui:SymbolIcon x:Name="QueueRowCriticalIcon" Grid.Column="1" Symbol="ErrorCircle24" FontSize="11" Margin="5,0,0,0"
                                                               VerticalAlignment="Center"
                                                               ToolTip="{Binding CriticalLabel}"
                                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                               Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisibility}}"/>
                                            </Grid>
                                            <!-- Same reason: the trailing star column hands the size text a bounded
                                                 width to trim against. -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding SourceDisplay}" FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <ui:SymbolIcon Grid.Column="1" Symbol="Shield24" FontSize="10" Margin="5,0,0,0"
                                                               VerticalAlignment="Center"
                                                               ToolTip="{Binding DataContext.Loc[InstallQueueNeedsAdminTooltip],
                                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVisibility}}"/>
                                                <!-- One tooltip for the whole lane, instead of
                                                     one per number, so the arrow and the gaps around it
                                                     are hit-testable too. -->
                                                <StackPanel x:Name="QueueVersionLane" Grid.Column="2" Orientation="Horizontal"
                                                            Background="Transparent"
                                                            ToolTip="{Binding VersionChangeTooltip}">
                                                    <TextBlock Text="{Binding InstalledVersion}" FontSize="10" Margin="6,0,0,0"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="70"
                                                               Style="{StaticResource TabularNumberText}"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Visibility="{Binding HasInstalledVersion, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Text="→" FontSize="10" Margin="3,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Visibility="{Binding HasInstalledVersion, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Text="{Binding AvailableVersion}" FontSize="10"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="70"
                                                               Style="{StaticResource TabularNumberText}"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Visibility="{Binding HasVersions, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding PublishDateText}" FontSize="10" Margin="6,0,0,0"
                                                           Style="{StaticResource TabularNumberText}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Visibility="{Binding HasPublishDate, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding DownloadSizeText}" FontSize="10" Margin="6,0,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{StaticResource TabularNumberText}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Visibility="{Binding HasDownloadSize, Converter={StaticResource BoolToVisibility}}"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Hidden (not just dimmed) until the card is hovered, so the row
                                             does not carry a permanent X. Hidden rather than
                                             Collapsed keeps the column's reserved width, so nothing else in
                                             the row shifts when it appears. -->
                                        <ui:Button x:Name="RemoveQueueButton" Grid.Column="3" Appearance="Transparent" Padding="6" Margin="4,0,0,0"
                                                   Command="{Binding DataContext.RemoveFromQueueCommand,
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="{Binding DataContext.Loc[InstallQueueRemoveTooltip],
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   AutomationProperties.Name="{Binding DataContext.Loc[InstallQueueRemoveTooltip],
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=QueueRowCard}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <!-- Also on keyboard focus anywhere inside the card (the card itself
                                                             or this button): keying on the card's own focus would hide the
                                                             button the moment Tab moves focus onto it. Hidden-until-hover alone
                                                             would leave a keyboard user unable to ever reach
                                                             this button, nothing to Tab to until the row that
                                                             reveals it can itself take focus. Entf on the card
                                                             (OnQueueRowKeyDown) reaches the same command without
                                                             needing a second Tab into the now-visible button. -->
                                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=QueueRowCard}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="12"/>
                                        </ui:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>
              </StackPanel>
              </Border>
            </Grid>
        </Border>

        <!-- One-line status strip, full width, directly above the table: names why the rows on screen
             are what they are (a cached result from last session, or a scan that found no connection at
             all). Same muted-surface style as the install/queue band above it, no red, no icon beyond the
             app's ordinary hint glyph. Collapsed (no reserved row height) when neither case applies; when
             both do, the connection banner explains the cached one too, so it wins. -->
        <Border x:Name="ScanStatusBanner" Grid.Row="5" Margin="24,0,24,8" Padding="12,7" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasCachedResult}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasConnectionBanner}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="Info24" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <!-- A Grid star column, not a horizontal StackPanel: a StackPanel measures its children at
                     infinite width, which silently defeats TextTrimming on the one long enough to need it. -->
                <TextBlock x:Name="ScanStatusBannerText" Grid.Column="1" Margin="8,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding CachedResultAgeText}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasConnectionBanner}" Value="True">
                                    <Setter Property="Text" Value="{Binding OfflineBannerText}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Results. Same 24px page margin on the right as on the left, so the card is
             inset symmetrically and the scrollbar sits inside it rather than flush to the window edge. -->
        <Grid Grid.Row="6" Margin="24,0,24,0">

            <!-- Empty state carries the primary action -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasResults}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- a tick would read as "all good" when the real reason is that a filter hid everything -->
                <ui:SymbolIcon FontSize="44" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Symbol" Value="CheckmarkCircle24"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterHidingEverything}" Value="True">
                                    <Setter Property="Symbol" Value="Search24"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowNotCheckedPrompt}" Value="True">
                                    <Setter Property="Symbol" Value="Search24"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <TextBlock x:Name="EmptyStateTextBlock" Text="{Binding EmptyStateText}" Margin="0,12,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <!-- Before any result exists the empty table is not an answer: the empty state carries the scan. -->
                <ui:Button x:Name="EmptyStateScanButton" HorizontalAlignment="Center" Margin="0,16,0,0"
                           Appearance="Primary" Padding="16,8"
                           Content="{Binding Loc[ScanButton]}"
                           Command="{Binding ScanCommand}"
                           Visibility="{Binding ShowNotCheckedPrompt, Converter={StaticResource BoolToVisibility}}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16"/>
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>

            <Border Style="{StaticResource SectionCard}"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
              <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- clickable column headers -->
                    <!-- Rows + the manual-open block share ONE scroll area (below) so the compact block
                         rolls with the table instead of sitting in its own capped box. -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column headers: click to sort within each category group; click the active one again
                     to flip direction. The insets approximate the row item's own margins/padding so the
                     labels line up over their lanes. -->
                <!-- Column order: Datum, Version, Größe. Widths stay attached to their content, not their
                     position: 168 (the wider lane, for "1.2.3 → 1.2.4") sits under Version, 88 under the
                     shorter Größe text. -->
                <Grid Grid.Row="0" Margin="12,4,26,5" MinHeight="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource ColWidthCheck}"/>
                        <ColumnDefinition Width="{StaticResource ColWidthIcon}"/>
                        <ColumnDefinition Width="*"/>
                        <!-- Publisher sits directly before date, hidden by default (see
                             App.xaml), still hideable through the column chooser. -->
                        <ColumnDefinition Width="{DynamicResource ColWidthPublisher}"/>
                        <ColumnDefinition Width="{DynamicResource ColWidthDate}"/>
                        <ColumnDefinition Width="{DynamicResource ColWidthVersion}"/>
                        <ColumnDefinition Width="{DynamicResource ColWidthSize}"/>
                        <ColumnDefinition Width="{StaticResource ColWidthAction}"/>
                    </Grid.ColumnDefinitions>

                    <!-- Select / clear every visible installable update at once. Tri-state: shows the
                         indeterminate box when only some are ticked. The category checkboxes below sit
                         flush with the ListBox's own left edge (no inset), while this header Grid carries
                         the card's usual 12px left margin - the negative margin cancels exactly that, so
                         this box lines up with them instead of sitting 12px right of them. MinHeight
                         matches the category header's own StackPanel MinHeight (30) for the same reason. -->
                    <CheckBox x:Name="SelectAllCheckBox" Grid.Column="0" Margin="-12,0,0,0"
                              VerticalAlignment="Center" HorizontalAlignment="Left"
                              IsThreeState="True"
                              IsChecked="{Binding AllVisibleSelected, Mode=OneWay}"
                              Command="{Binding SelectAllCommand}"
                              ToolTip="{Binding SelectAllTooltip, Converter={StaticResource ShortcutTooltip}, ConverterParameter=SelectAllButton}"
                              AutomationProperties.Name="{Binding SelectAllTooltip}"/>

                    <!-- Column titles: bigger (14, like the category headers) and vertically centred in the
                         header strip; date/size/version are centred to their own lane, name stays left. -->
                    <StackPanel x:Name="SortHeaderName" Grid.Column="2" Orientation="Horizontal" Cursor="Hand" Margin="10,0,12,0"
                                VerticalAlignment="Center" Focusable="True" KeyDown="OnClickTargetKeyDown"
                                AutomationProperties.Name="{Binding Loc[ColumnName]}"
                                ToolTip="{Binding NameSortTooltip}">
                        <StackPanel.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SortByCommand}" CommandParameter="name"/>
                        </StackPanel.InputBindings>
                        <TextBlock Text="{Binding Loc[ColumnName]}" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <!-- Fixed width so the arrow appearing/disappearing never nudges the label. -->
                        <TextBlock Text="{Binding NameSortGlyph}" Style="{StaticResource SortGlyphText}"/>
                    </StackPanel>

                    <!-- Publisher, hidden by default; a plain label, not clickable, there is
                         no per-row sort key for it. -->
                    <TextBlock Grid.Column="3" Text="{Binding Loc[ColumnPublisher]}" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <StackPanel x:Name="SortHeaderDate" Grid.Column="4" Orientation="Horizontal" Cursor="Hand" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Focusable="True" KeyDown="OnClickTargetKeyDown"
                                AutomationProperties.Name="{Binding Loc[ColumnDate]}"
                                ToolTip="{Binding DateSortTooltip}">
                        <StackPanel.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SortByCommand}" CommandParameter="date"/>
                        </StackPanel.InputBindings>
                        <TextBlock Text="{Binding Loc[ColumnDate]}" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding DateSortGlyph}" Style="{StaticResource SortGlyphText}"/>
                    </StackPanel>

                    <StackPanel x:Name="SortHeaderVersion" Grid.Column="5" Orientation="Horizontal" Cursor="Hand" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Focusable="True" KeyDown="OnClickTargetKeyDown"
                                AutomationProperties.Name="{Binding Loc[ColumnVersion]}"
                                ToolTip="{Binding VersionSortTooltip}">
                        <StackPanel.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SortByCommand}" CommandParameter="version"/>
                        </StackPanel.InputBindings>
                        <TextBlock Text="{Binding Loc[ColumnVersion]}" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding VersionSortGlyph}" Style="{StaticResource SortGlyphText}"/>
                    </StackPanel>

                    <StackPanel x:Name="SortHeaderSize" Grid.Column="6" Orientation="Horizontal" Cursor="Hand" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Focusable="True" KeyDown="OnClickTargetKeyDown"
                                AutomationProperties.Name="{Binding Loc[ColumnSize]}"
                                ToolTip="{Binding SizeSortTooltip}">
                        <StackPanel.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SortByCommand}" CommandParameter="size"/>
                        </StackPanel.InputBindings>
                        <TextBlock Text="{Binding Loc[ColumnSize]}" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding SizeSortGlyph}" Style="{StaticResource SortGlyphText}"/>
                    </StackPanel>

                    <!-- The shared column chooser (Views/ColumnChooser.cs), opened here for the main table
                         it configures; MainWindow.xaml.cs builds the menu from MainViewModel's own column
                         list rather than one being declared in XAML per window. Subtle, right-aligned in
                         the action lane. -->
                    <ui:Button x:Name="MainColumnsButton" Grid.Column="7" Click="OnColumnsButtonClick"
                               Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Appearance="Transparent"
                               ToolTip="{Binding Loc[ColumnsButton]}" AutomationProperties.Name="{Binding Loc[ColumnsButton]}">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="ColumnEdit24" FontSize="16"/></ui:Button.Icon>
                    </ui:Button>
                </Grid>

                <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Margin="12,0,26,0"
                        Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                <!-- Rows and the manual-open block below share this ONE reserved-lane ScrollViewer
                     (14px classic bar, themed by the app-wide ScrollBar style, same Style="{x:Null}"
                     trick the table's own template used to apply locally) instead of each having its
                     own scroll area. Pixel scrolling (CanContentScroll=False), not item scrolling: the
                     bar glides smoothly over every row instead of jumping a whole category at a time.
                     The table's own ListBox loses virtualization here (every row is realized, not just
                     the visible ones), measured at 300 rows, steady-state window build time: ~2920 ms
                     before vs. ~2923 ms after, well under the 150 ms budget, so left as is. -->
                <ScrollViewer x:Name="ResultsScrollViewer" Grid.Row="1" Style="{x:Null}" Focusable="False"
                              CanContentScroll="False" PanningMode="VerticalOnly"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Visible">
                <StackPanel>
                <!-- Grouped virtualization is deliberately OFF: WPF's virtualizing panel drops or blanks
                     rows when groups are expanded/collapsed (rows "disappeared" after a fold), so the
                     grouped list renders in full. Update lists are dozens of rows in normal use, so the
                     cost is negligible next to a correct table. Losing the ListBox's own virtualization
                     to the shared outer ScrollViewer costs nothing extra on top of that, measured
                     at 300 rows. -->
                <ListBox x:Name="UpdatesListBox" ItemsSource="{Binding UpdatesView}"
                         Background="Transparent" BorderThickness="0"
                         Padding="0,4,8,10"
                         HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="False"
                         AlternationCount="2"
                         PreviewKeyDown="OnUpdatesListPreviewKeyDown">

                    <!-- The ListBox's own class command binding answers Ctrl+A itself (selecting list
                         items, not our rows' IsSelected checkboxes) once focus moves inside it, so the
                         window-level KeyBinding above never sees the key. An instance CommandBinding on
                         the SAME element is checked before that class one, so this one wins and forwards
                         to the identical SelectAllCommand the window binding already uses - one command,
                         reachable from both places. -->
                    <ListBox.CommandBindings>
                        <CommandBinding Command="ApplicationCommands.SelectAll"
                                         Executed="OnUpdatesListSelectAllExecuted"
                                         CanExecute="OnUpdatesListSelectAllCanExecute"/>
                    </ListBox.CommandBindings>

                    <!-- No ScrollViewer of its own: the outer one above scrolls
                         both this and the manual-open block; a nested one here would be a second,
                         redundant scroll area. -->
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </ControlTemplate>
                    </ListBox.Template>


                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="4,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Focusable" Value="True"/>
                            <!-- Continue lets Tab walk into the row's CheckBox/Open button (WPF's default
                                 Once would skip over both). A focused CheckBox already toggles on Space by
                                 itself; toggling straight from row-level focus would need a Command the row
                                 VM doesn't expose, so that part stays undone. -->
                            <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue"/>
                            <!-- Double-clicking a manual-open row (a store, a launcher) runs its Open
                                 action, since those rows have no checkbox to act on. -->
                            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root" CornerRadius="6" Background="Transparent" Padding="8,3">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- Alternating resting background only, so the table separates
                                                 without a grid of lines; grouped display restarts alternation
                                                 inside each category (accepted). Listed before the
                                                 hover/focus triggers below so those still win when the
                                                 pointer is actually over an odd row. -->
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                <Setter TargetName="Root" Property="Background"
                                                        Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background"
                                                        Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="Root" Property="Background"
                                                        Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                            </Trigger>
                                            <!-- A row eases in rather than appearing hard, so a scan streaming
                                                 in results reads as the table filling up instead of
                                                 flickering. Opacity ONLY and capped at 60 fps, because
                                                 a transform here is costly. -->
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard Timeline.DesiredFrameRate="60">
                                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.14"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <!-- Every row (including the manual-open ones now) gets the shared
                                 RowActionsMenu, with Start at the very top. Version-specific ignore is
                                 shown only for real update rows; manual rows get a single plain "ignore". -->
                            <Setter Property="ContextMenu" Value="{StaticResource RowActionsMenu}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <!-- Category groups: chevron sits next to its label, not across the window. -->
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <!-- Even top/bottom margin so a run of collapsed groups sits at a
                                                     steady rhythm, and the header content is centred on the chevron
                                                     so nothing jumps as a group folds shut. IsExpanded is set from
                                                     code-behind (Loaded) rather than hardcoded: WPF regenerates
                                                     these groups as the table refreshes, and a hardcoded default
                                                     would silently reopen whatever the user had collapsed. -->
                                                <Expander Margin="0,1,0,2" Padding="0" BorderThickness="0"
                                                          Background="Transparent" HorizontalContentAlignment="Stretch"
                                                          Loaded="OnGroupExpanderLoaded"
                                                          Expanded="OnGroupExpanderToggled"
                                                          Collapsed="OnGroupExpanderToggled">
                                                    <!-- Own template instead of the stock one: the whole header row
                                                         (everything but the category checkbox, which handles its own
                                                         click) is the toggle, and there is no right-hand chevron; the
                                                         chevron sits in the header itself, between the checkbox and
                                                         the icon. -->
                                                    <Expander.Template>
                                                        <ControlTemplate TargetType="Expander">
                                                            <StackPanel>
                                                                <ToggleButton x:Name="GroupHeaderToggle" Focusable="True"
                                                                              HorizontalAlignment="Stretch"
                                                                              HorizontalContentAlignment="Stretch"
                                                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border x:Name="Hit" Background="Transparent" CornerRadius="4"
                                                                                    BorderThickness="1" BorderBrush="Transparent">
                                                                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                    <Setter TargetName="Hit" Property="BorderBrush"
                                                                                            Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                    <ContentPresenter ContentSource="Header"/>
                                                                </ToggleButton>
                                                                <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed"/>
                                                            </StackPanel>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsExpanded" Value="True">
                                                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Expander.Template>
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                    MinHeight="30">
                                                            <!-- Ticks or clears every installable row in this
                                                                 category at once. The command decides which of
                                                                 the two by what is already selected. -->
                                                            <!-- Tri-state, so ticking everything from the header
                                                                 (or the bottom button) visibly ticks the
                                                                 categories too. It binds to
                                                                 SelectionVersion as well, because a group raises
                                                                 nothing when a row inside it changes. -->
                                                            <!-- Visibility also binds to SelectionVersion, same reason
                                                                 as IsChecked below: a group raises nothing when a row
                                                                 inside it changes state, so the last installable row
                                                                 being queued left this checkbox visibly stuck without it. -->
                                                            <CheckBox x:Name="CategoryCheckBox" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                      IsThreeState="True"
                                                                      AutomationProperties.Name="{Binding Name}"
                                                                      CommandParameter="{Binding}"
                                                                      Command="{Binding DataContext.SelectCategoryCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ListBox}}">
                                                                <CheckBox.Visibility>
                                                                    <MultiBinding Converter="{StaticResource GroupInstallable}" Mode="OneWay">
                                                                        <Binding/>
                                                                        <Binding Path="DataContext.SelectionVersion"
                                                                                 RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                                    </MultiBinding>
                                                                </CheckBox.Visibility>
                                                                <CheckBox.IsChecked>
                                                                    <MultiBinding Converter="{StaticResource GroupSelection}" Mode="OneWay">
                                                                        <Binding/>
                                                                        <Binding Path="DataContext.SelectionVersion"
                                                                                 RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                                    </MultiBinding>
                                                                </CheckBox.IsChecked>
                                                            </CheckBox>
                                                            <!-- Same drawn chevron as the cleanup window cards (a Path rotates
                                                                 cleanly and needs no icon font): pointing down when
                                                                 collapsed, turned over when expanded. -->
                                                            <Path x:Name="GroupChevron" Margin="0,0,10,0"
                                                                  Data="M0,0 L5,5 L10,0" StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round" VerticalAlignment="Center"
                                                                  Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                                                                  RenderTransformOrigin="0.5,0.5">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="RenderTransform">
                                                                            <Setter.Value>
                                                                                <RotateTransform Angle="0"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                                                <Setter Property="RenderTransform">
                                                                                    <Setter.Value>
                                                                                        <RotateTransform Angle="180"/>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                            <!-- A modern Fluent glyph per category, left of its name. -->
                                                            <ui:SymbolIcon Symbol="{Binding Items[0].CategoryKey, Converter={StaticResource CategoryIcon}}"
                                                                           FontSize="18" Margin="0,0,9,0" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       FontSize="14" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                                       FontSize="14" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter Margin="0,1,0,0"/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>

                    <!-- Row: checkbox · icon · name over source · version change · action/state -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel>
                            <!-- Fixed content height so no row is ever taller than its siblings, however long
                                 its name. Name and version are both single-line-with-ellipsis
                                 now, so nothing wraps into it; ClipToBounds stays as the backstop for anything
                                 that still overruns. Height came down from 56 to 48, and the row padding with
                                 it. -->
                            <Grid x:Name="TableRow" Height="48" ClipToBounds="True">
                                <!-- The columns to the RIGHT of the starred name are all fixed width, so
                                     date · size · version · action each keep the same column on every row
                                     and read as clean vertical lanes. An ignored row is
                                     dimmed as well as badged. -->
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                                <Setter Property="Opacity" Value="0.55"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSnoozed}" Value="True">
                                                <Setter Property="Opacity" Value="0.55"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource ColWidthCheck}"/>
                                    <ColumnDefinition Width="{StaticResource ColWidthIcon}"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="{DynamicResource ColWidthPublisher}"/>
                                    <ColumnDefinition Width="{DynamicResource ColWidthDate}"/>
                                    <ColumnDefinition Width="{DynamicResource ColWidthVersion}"/>
                                    <ColumnDefinition Width="{DynamicResource ColWidthSize}"/>
                                    <ColumnDefinition Width="{StaticResource ColWidthAction}"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          IsChecked="{Binding IsSelected}"
                                          Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}"
                                          AutomationProperties.Name="{Binding Name}"/>

                                <Grid Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center">
                                    <!-- Fallback only: it keeps the gutter from looking ragged when no icon
                                         resolves, and it disappears the moment a real one does, a round
                                         app icon otherwise showed the square tile through its corners. -->
                                    <Border CornerRadius="4" Background="{Binding InitialBrush}"
                                            Visibility="{Binding UsesTile, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <TextBlock Text="{Binding InitialLetter}" FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TileGlyphBrush}"
                                                       Visibility="{Binding UsesLetterTile, Converter={StaticResource BoolToVisibility}}"/>

                                            <ui:SymbolIcon FontSize="13" Foreground="{StaticResource TileGlyphBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding UsesGlyphTile, Converter={StaticResource BoolToVisibility}}">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Box24"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Item.Category}" Value="SystemAndDrivers">
                                                                <Setter Property="Symbol" Value="Shield24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Item.Category}" Value="DeveloperTools">
                                                                <Setter Property="Symbol" Value="Code24"/>
                                                            </DataTrigger>
                                                            <!-- Microsoft's own marks are not in the bundled
                                                                 icon set (their owners had them removed
                                                                 upstream), so the Store fell through to the
                                                                 generic box. -->
                                                            <DataTrigger Binding="{Binding Item.Category}" Value="Store">
                                                                <Setter Property="Symbol" Value="StoreMicrosoft24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Item.Category}" Value="Games">
                                                                <Setter Property="Symbol" Value="Games24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>

                                            <!-- bundled brand mark: monochrome on the tile colour, so
                                                 no row invents a brand colour of its own -->
                                            <Path Data="{Binding BrandGeometry}" Fill="{StaticResource TileGlyphBrush}" Stretch="Uniform"
                                                  Width="14" Height="14"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding UsesBrandTile, Converter={StaticResource BoolToVisibility}}"/>
                                        </Grid>
                                    </Border>
                                    <Image Source="{Binding Icon}" Width="24" Height="24"/>
                                </Grid>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,12,0">
                                    <!-- Grid, not a horizontal StackPanel: a StackPanel measures its
                                         children with infinite width, so TextTrimming never engaged
                                         and a long name was simply cut off mid-letter. -->
                                    <!-- HorizontalAlignment=Left is what makes the badges HUG the name.
                                         Left-aligned, the Grid arranges at its desired width, so
                                         the star column shrinks to the text instead of pushing the badges
                                         out to the far edge of the cell. Measure still passes the real
                                         available width, so a long name trims exactly as before. -->
                                    <Grid HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- One line, then an ellipsis. Wrapping made a long name push the source
                                             line out of the row's fixed height and end in a half-drawn line of
                                             its own (worst at 200% scale and minimum width), and it made rows
                                             uneven in a table whose whole point is columns that line up. The
                                             full name is on the tooltip, it also puts the package id,
                                             source and (where known) publisher there, one per line. -->
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding NameTooltip}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <!-- Both marks sit to the RIGHT of the name: the
                                             critical badge first, then the ignored mark. -->
                                        <Border Grid.Column="1" Margin="8,0,0,0" Padding="8,2" CornerRadius="5"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                                Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding CriticalLabel}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                        </Border>
                                        <Border Grid.Column="2" Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                Visibility="{Binding IsIgnored, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding IgnoredBadgeLabel}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </Border>
                                        <!-- Says until WHEN, unlike the plain "Ignored" pill, without this a
                                             row revealed by the "Zurückgestellt" chip gives no reason to trust
                                             it will come back on its own. -->
                                        <Border Grid.Column="3" Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                Visibility="{Binding IsSnoozed, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding SnoozedBadgeLabel}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </Border>
                                    </Grid>
                                    <!-- The source line ("Battle.net", "Rockstar Games", …) is dropped for
                                         manual-open rows where it just repeats the name; the name then sits
                                         vertically centred on its own. -->
                                    <!-- When the same update is on offer from more than one source the table
                                         shows ONE row and names them all here, best first.
                                         The first one is the source that will actually do the work. -->
                                    <TextBlock Text="{Binding AllSourcesText}" FontSize="11" Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding AllSourcesTooltip}"
                                               Visibility="{Binding ShowSourceText, Converter={StaticResource BoolToVisibility}}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <!-- A failed row says WHY here, in place of the source: the translated
                                         explainer only, never raw tool output (that stays behind Details). -->
                                    <TextBlock x:Name="FailureLineText" Text="{Binding FailureLine}" FontSize="11" Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FailureLine}"
                                               Visibility="{Binding IsInstallFailed, Converter={StaticResource BoolToVisibility}}"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                    <!-- A cancelled row that carries its own reason (a blocked row the user
                                         skipped) says it here in place of the source; nothing failed, so the
                                         secondary text brush, not the critical one. -->
                                    <TextBlock x:Name="CancelledReasonText" Text="{Binding CancelledReasonLine}" FontSize="11" Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding CancelledReasonLine}"
                                               Visibility="{Binding ShowCancelledReason, Converter={StaticResource BoolToVisibility}}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <!-- A one-line nudge once the three-strikes tally has flagged
                                         this row, wired straight to the row's own existing ignore command
                                         rather than a new one. -->
                                    <!-- A WPF-UI ui:Button reserves more vertical room than its own
                                         Padding suggests (its default style/template sets its own MinHeight),
                                         which tipped this row's third stacked line past the row's fixed 48px
                                         height and clipped the text's descenders against ClipToBounds. MinHeight
                                         and BorderThickness are both zeroed so the button takes only as much
                                         room as its own text content, matching the plain TextBlock line above it.
                                         Padding top and bottom gives the line's own descenders (from
                                         "ignorieren", "g") room to clear that same ClipToBounds edge, and
                                         the matching negative top Margin gives that room back to the
                                         StackPanel's own layout so the row's total stacked height still
                                         does not pass 48px: the button's own box grows, its footprint in
                                         the stack does not. -->
                                    <ui:Button Content="{Binding PersistentFailureHintText}"
                                               Command="{Binding IgnoreCommand}"
                                               Appearance="Transparent" Padding="0,2" Margin="0,-5,0,0"
                                               MinHeight="0" BorderThickness="0"
                                               HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                               VerticalAlignment="Top" VerticalContentAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding ShowPersistentFailureHint, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>

                                <!-- Date lane: its own fixed column so every row's date lines up. Filled
                                     up front where the source dates, or later by the background enrichment
                                     pass (a package's own registry). Centred within its lane, matching the
                                     header. -->
                                <TextBlock Grid.Column="4" Text="{Binding PublishDateText}" FontSize="12"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Style="{StaticResource TabularNumberText}"
                                           Visibility="{Binding HasPublishDate, Converter={StaticResource BoolToVisibility}}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                                <!-- Version lane. Sources that cannot report what is installed show only
                                     the new version, rather than an arrow pointing away from nothing.
                                     Column order Datum/Version/Größe, centred like the header. A fixed
                                     4-column Grid (62/14/62/20 = 158px, 10px to spare in the 168px lane)
                                     instead of a centred StackPanel: a StackPanel's width varies with which
                                     children are visible per row (no installed version, a changelog
                                     link), so the arrow landed in a different X position on every row and,
                                     since only the arrow had VerticalAlignment="Center" while the stretched
                                     text blocks paint at their box's TOP, sat visibly lower than the text.
                                     The old fourth column (20px) now holds the changelog spinner. -->
                                <!-- One tooltip for the whole lane (Background="Transparent"
                                     makes the gaps and the arrow hit-testable too), instead of one on
                                     each of the two version TextBlocks. -->
                                <Grid x:Name="VersionLane" Grid.Column="5" Width="158" VerticalAlignment="Center"
                                      HorizontalAlignment="Center" Background="Transparent"
                                      ToolTip="{Binding VersionChangeTooltip}"
                                      Visibility="{Binding HasVersions, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" x:Name="InstalledVersionText" Text="{Binding InstalledVersion}" FontSize="12"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               TextAlignment="Right" Style="{StaticResource TabularNumberText}"
                                               Visibility="{Binding HasInstalledVersion, Converter={StaticResource BoolToVisibility}}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Grid.Column="1" x:Name="VersionArrow" Text="→" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasInstalledVersion, Converter={StaticResource BoolToVisibility}}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <!-- The available version. Spans its own 62px column plus the old
                                         changelog column (the spinner's place) when there is an installed
                                         version to arrow away from, otherwise the whole 158px lane, centred.
                                         Column/alignment come from the Style, not a local value, since a
                                         local value always outranks a Style Setter/Trigger regardless of
                                         which one is written last. With a changelog the version is a link
                                         that opens it, without one it stays plain text. -->
                                    <Grid x:Name="AvailableVersionHost" VerticalAlignment="Center">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Grid.Column" Value="2"/>
                                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasInstalledVersion}" Value="False">
                                                        <Setter Property="Grid.Column" Value="0"/>
                                                        <Setter Property="Grid.ColumnSpan" Value="4"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="AvailableVersionText" Text="{Binding AvailableVersion}" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TabularNumberText}">
                                                    <Setter Property="TextAlignment" Value="Left"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasInstalledVersion}" Value="False">
                                                            <Setter Property="TextAlignment" Value="Center"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasChangelog}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Button x:Name="AvailableVersionLink" Content="{Binding AvailableVersion}"
                                                Command="{Binding ShowChangelogCommand}"
                                                ToolTip="{Binding ChangelogHeader}"
                                                AutomationProperties.Name="{Binding ChangelogHeader}"
                                                Visibility="{Binding HasChangelog, Converter={StaticResource BoolToVisibility}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource VersionLinkButton}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasInstalledVersion}" Value="False">
                                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- A click-triggered fetch in flight: a small ring right of the version. -->
                                        <views:WaitSpinner Grid.Column="1" Width="12" Height="12" Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsChangelogLoading, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </Grid>

                                <!-- Size lane, where the source or the enrichment pass knew it; blank otherwise. -->
                                <TextBlock Grid.Column="6" Text="{Binding DownloadSizeText}" FontSize="12"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Style="{StaticResource TabularNumberText}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding HasDownloadSize, Converter={StaticResource BoolToVisibility}}"/>

                                <Grid Grid.Column="7" VerticalAlignment="Center">
                                    <!-- Idle installable row: a per-row Install button that queues just
                                         this update (it joins any batch already running). -->
                                    <ui:Button Content="{Binding InstallHeader}" Command="{Binding InstallCommand}"
                                               Appearance="Secondary" Padding="12,3" FontSize="12"
                                               HorizontalAlignment="Right"
                                               Visibility="{Binding ShowInstallButton, Converter={StaticResource BoolToVisibility}}"/>

                                    <ui:Button Content="{Binding OpenHeader}" Command="{Binding OpenCommand}"
                                               Appearance="Secondary" Padding="10,3" FontSize="12"
                                               HorizontalAlignment="Right"
                                               Visibility="{Binding ShowOpenButton, Converter={StaticResource BoolToVisibility}}"/>

                                    <!-- Running: either the hand-drawn bar or the interactive label (never
                                         both), plus this row's own stop button, all in one
                                         Right-aligned group so they sit side by side instead of overlapping
                                         (every sibling here is HorizontalAlignment="Right" on its own). -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsInstallRunning, Converter={StaticResource BoolToVisibility}}">
                                        <!-- the percentage, then a hand-drawn bar. A hand-drawn bar
                                             (a track Border with a fill Border sized by a percent→width
                                             converter) is used rather than a ProgressBar on purpose: a
                                             WPF-UI ProgressBar given a star-sized or infinite measure here
                                             sends the layout into an infinite measure recursion. -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding ShowRunningProgress, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock x:Name="RunningPercentText" Text="{Binding InstallPercentText}" FontSize="12"
                                                       VerticalAlignment="Center" MinWidth="34" TextAlignment="Right"
                                                       Margin="0,0,8,0" Style="{StaticResource TabularNumberText}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <Border Width="96" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <Border HorizontalAlignment="Left" CornerRadius="3"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        Width="{Binding InstallPercent, Converter={StaticResource PercentToWidth}, ConverterParameter=96}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- The vendor's own UI is driving, so a percentage would be
                                             meaningless, the row says so in words instead. -->
                                        <TextBlock Text="{Binding InteractiveRunningText}" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding ShowInteractiveRunningLabel, Converter={StaticResource BoolToVisibility}}"/>

                                        <!-- this row's own stop button: stops just this one,
                                             the rest of the queue keeps running. -->
                                        <ui:Button Margin="8,0,0,0" Padding="5,2" Appearance="Secondary"
                                                   Command="{Binding StopSingleCommand}"
                                                   ToolTip="{Binding StopSingleTooltip}"
                                                   AutomationProperties.Name="{Binding StopSingleTooltip}"
                                                   Visibility="{Binding ShowStopSingleButton, Converter={StaticResource BoolToVisibility}}">
                                            <ui:SymbolIcon Symbol="Stop24" FontSize="13" Filled="True"
                                                                         Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                        </ui:Button>
                                    </StackPanel>

                                    <!-- queued / done / failed. A failure shows a red warning icon rather than
                                         the easily-missed "failed" word (the retry/details buttons make the
                                         state obvious anyway). Details (info) comes first, then Retry. -->
                                    <!-- A DockPanel, not a horizontal StackPanel: it measures each child with what is
                                         left of the column, so the marker texts below really trim instead of
                                         pushing the whole group out past the column's left edge. -->
                                    <DockPanel LastChildFill="False" HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding ShowStateLabel, Converter={StaticResource BoolToVisibility}}">
                                        <!-- Queued: a turning ring in front of the word, so a waiting row
                                             reads as waiting rather than as stuck. -->
                                        <views:WaitSpinner Margin="0,0,7,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsInstallQueued, Converter={StaticResource BoolToVisibility}}"/>
                                        <!-- RowStuck/RowHandedOff show a single word, the full sentence lives in the tooltip
                                             (InstallStateTooltip). MaxWidth is what makes TextTrimming engage
                                             (a StackPanel measures its children with infinite width in the
                                             stack direction, so trimming alone never trims; same reasoning
                                             as the name column's own Grid-instead-of-StackPanel fix above),
                                             and guards the 150px action column against a longer word. -->
                                        <TextBlock x:Name="RowStateWord" VerticalAlignment="Center" MaxWidth="140"
                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding InstallStateText}"
                                                   ToolTip="{Binding InstallStateTooltip}"
                                                   ToolTipService.InitialShowDelay="150"
                                                   Visibility="{Binding ShowStateWord, Converter={StaticResource BoolToVisibility}}"
                                                   Foreground="{Binding InstallStateBrush}"/>
                                        <!-- failed: a red warning triangle; the reason is one hover (or the
                                             details button) away -->
                                        <ui:SymbolIcon Symbol="Warning24" FontSize="16" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                       ToolTip="{Binding InstallFailedTooltip}"
                                                       ToolTipService.InitialShowDelay="150"
                                                       AutomationProperties.Name="{Binding InstallFailedTooltip}"
                                                       Visibility="{Binding IsInstallFailed, Converter={StaticResource BoolToVisibility}}"/>
                                        <!-- installed, but a reboot is pending -->
                                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding RebootMarkerText}"
                                                   ToolTip="{Binding RebootMarkerText}"
                                                   Visibility="{Binding NeedsReboot, Converter={StaticResource BoolToVisibility}}"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                        <!-- installed, but the re-check found the same version as
                                             before; a quiet note, not a warning, so no caution colour here -->
                                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding VersionUnchangedText}"
                                                   ToolTip="{Binding VersionUnchangedText}"
                                                   Visibility="{Binding VersionUnchanged, Converter={StaticResource BoolToVisibility}}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <!-- the details button carries the real tool output on demand -->
                                        <ui:Button Margin="8,0,0,0" Padding="5,2" Appearance="Secondary"
                                                   Command="{Binding ShowErrorDetailCommand}"
                                                   ToolTip="{Binding DetailsHeader}"
                                                   AutomationProperties.Name="{Binding DetailsHeader}"
                                                   Visibility="{Binding HasInstallError, Converter={StaticResource BoolToVisibility}}">
                                            <ui:SymbolIcon Symbol="Info24" FontSize="13"/>
                                        </ui:Button>
                                        <!-- a failed row can be retried -->
                                        <ui:Button Margin="6,0,0,0" Padding="10,3" FontSize="12" Appearance="Secondary"
                                                   Content="{Binding RetryHeader}" Command="{Binding RetryCommand}"
                                                   Visibility="{Binding ShowRetryButton, Converter={StaticResource BoolToVisibility}}"/>
                                    </DockPanel>

                                    <!-- Ignored rows offer an inline "show again" where their Install
                                         button would otherwise be. A subtle accent-coloured text button
                                         rather than a solid secondary one, whose black text looked out of
                                         place on the dimmed row. -->
                                    <ui:Button Content="{Binding UnignoreHeader}" Command="{Binding IgnoreCommand}"
                                               Appearance="Transparent" Padding="8,3" FontSize="12"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Right"
                                               Visibility="{Binding ShowUnignoreButton, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>

                                <!-- Publisher, hidden by default, shown through the column
                                     chooser. Blank rather than a hyphen where the id carries none,
                                     matching how the rest of this row leaves an unknown fact out rather
                                     than marking it. Text is the shortened form (Services/PublisherShortener.cs);
                                     the tooltip keeps the full, unshortened name for whenever it differs. -->
                                <TextBlock Grid.Column="3" Text="{Binding PublisherDisplay}" FontSize="12"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Publisher}"
                                           Visibility="{Binding HasPublisher, Converter={StaticResource BoolToVisibility}}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Grid>

                            <!-- Steam's pending game updates hang under the Steam launcher row as a
                                 collapsible sub-list instead of filling a category of their own. The
                                 open/closed state lives in the view model, so a scan streaming in new
                                 results cannot silently reopen what the user just closed. -->
                            <Expander Margin="44,4,0,8" Padding="0" BorderThickness="0"
                                      Background="Transparent" HorizontalContentAlignment="Stretch"
                                      Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}"
                                      IsExpanded="{Binding AreChildrenExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <!-- Exactly the category group header's shape: the same
                                         MinHeight and font. The update glyph is gone but
                                         the MinHeight stays, so the row keeps its height either way. -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MinHeight="30">
                                        <TextBlock Text="{Binding ChildCountText}" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </Expander.Header>

                                <ItemsControl ItemsSource="{Binding Children}" Margin="0,6,0,2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- A child is a row in its own right: right-click still starts
                                                 or removes the game. It also gets its OWN hover highlight,
                                                 not just the whole Steam card's, the parent ListBoxItem's
                                                 hover Border wraps the entire card INCLUDING this nested
                                                 ItemsControl, so without a highlight of its own, pointing at
                                                 one game would light up the whole card rather than that
                                                 game's own line. -->
                                            <!-- Focusable so Tab/arrow navigation can reach a Steam child game
                                                 at all, Space/Enter/Delete on it route through the same
                                                 OnUpdatesListPreviewKeyDown handler as a top-level row, since
                                                 that handler tunnels down from the ListBox regardless of
                                                 nesting depth. The context menu lives on this element (not the
                                                 inner Grid) so the Apps-key/Shift+F10 default WPF behaviour,
                                                 which looks at whatever element currently has keyboard focus,
                                                 finds it. -->
                                            <Border x:Name="ChildRow" CornerRadius="6" Margin="0,1" Padding="6,2"
                                                    Focusable="True"
                                                    AutomationProperties.Name="{Binding Name}">
                                                <Border.ContextMenu>
                                                    <!-- Same themed card surface as the main row menu. -->
                                                    <ContextMenu Style="{StaticResource RowContextMenu}"
                                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Style="{StaticResource RowMenuItem}"
                                                                  Header="{Binding StartHeader}" Command="{Binding StartCommand}"
                                                                  Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibility}}"/>
                                                        <MenuItem Style="{StaticResource RowMenuItem}"
                                                                  Header="{Binding UninstallHeader}" Command="{Binding UninstallCommand}"
                                                                  Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVisibility}}"/>
                                                        <MenuItem Style="{StaticResource RowMenuItem}"
                                                                  Header="{Binding OpenFolderHeader}" Command="{Binding OpenFolderCommand}"
                                                                  Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVisibility}}"/>
                                                        <MenuItem Style="{StaticResource RowSubmenuItem}" Header="{Binding SnoozeHeader}"
                                                                  Visibility="{Binding ShowSnoozeMenu, Converter={StaticResource BoolToVisibility}}">
                                                            <MenuItem Style="{StaticResource RowMenuItem}"
                                                                      Header="{Binding SnoozeOneDayHeader}" Command="{Binding SnoozeCommand}" CommandParameter="day"/>
                                                            <MenuItem Style="{StaticResource RowMenuItem}"
                                                                      Header="{Binding SnoozeOneWeekHeader}" Command="{Binding SnoozeCommand}" CommandParameter="week"/>
                                                            <MenuItem Style="{StaticResource RowMenuItem}"
                                                                      Header="{Binding SnoozeOneMonthHeader}" Command="{Binding SnoozeCommand}" CommandParameter="month"/>
                                                        </MenuItem>
                                                        <MenuItem Style="{StaticResource RowMenuItem}"
                                                                  Header="{Binding UnsnoozeHeader}" Command="{Binding UnsnoozeCommand}"
                                                                  Visibility="{Binding ShowUnsnoozeEntry, Converter={StaticResource BoolToVisibility}}"/>
                                                        <MenuItem Style="{StaticResource RowMenuItem}"
                                                                  Header="{Binding ResetPersistentFailureHeader}" Command="{Binding ResetPersistentFailureCommand}"
                                                                  Visibility="{Binding ShowResetPersistentFailureEntry, Converter={StaticResource BoolToVisibility}}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="{DynamicResource ColWidthDate}"/>
                                                    <ColumnDefinition Width="{StaticResource ColWidthAction}"/>
                                                </Grid.ColumnDefinitions>

                                                <Image Grid.Column="0" Source="{Binding Icon}"
                                                       Width="22" Height="22" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,12,0"
                                                           FontSize="14" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                                <!-- State lane: the same words, spinner and details button the parent row's action
                                                     column carries, so a game removal shows what it is doing and
                                                     that it finished. Auto width, so an idle game reserves nothing. -->
                                                <StackPanel x:Name="ChildStateLane" Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <StackPanel x:Name="ChildRunningLane" Orientation="Horizontal" VerticalAlignment="Center"
                                                                Visibility="{Binding IsInstallRunning, Converter={StaticResource BoolToVisibility}}">
                                                        <views:WaitSpinner Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding InstallPercentText}" FontSize="12" VerticalAlignment="Center"
                                                                   Style="{StaticResource TabularNumberText}"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{Binding ShowRunningProgress, Converter={StaticResource BoolToVisibility}}"/>
                                                        <TextBlock Text="{Binding InteractiveRunningText}" FontSize="12" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{Binding ShowInteractiveRunningLabel, Converter={StaticResource BoolToVisibility}}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                Visibility="{Binding ShowStateLabel, Converter={StaticResource BoolToVisibility}}">
                                                        <views:WaitSpinner Margin="0,0,7,0" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsInstallQueued, Converter={StaticResource BoolToVisibility}}"/>
                                                        <TextBlock x:Name="ChildStateWord" VerticalAlignment="Center" MaxWidth="140"
                                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding InstallStateText}"
                                                                   ToolTip="{Binding InstallStateTooltip}"
                                                                   ToolTipService.InitialShowDelay="150"
                                                                   Visibility="{Binding ShowStateWord, Converter={StaticResource BoolToVisibility}}"
                                                                   Foreground="{Binding InstallStateBrush}"/>
                                                        <ui:SymbolIcon Symbol="Warning24" FontSize="16" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                                       ToolTip="{Binding InstallFailedTooltip}"
                                                                       ToolTipService.InitialShowDelay="150"
                                                                       AutomationProperties.Name="{Binding InstallFailedTooltip}"
                                                                       Visibility="{Binding IsInstallFailed, Converter={StaticResource BoolToVisibility}}"/>
                                                        <ui:Button Margin="8,0,0,0" Padding="5,2" Appearance="Secondary"
                                                                   Command="{Binding ShowErrorDetailCommand}"
                                                                   ToolTip="{Binding DetailsHeader}"
                                                                   AutomationProperties.Name="{Binding DetailsHeader}"
                                                                   Visibility="{Binding HasInstallError, Converter={StaticResource BoolToVisibility}}">
                                                            <ui:SymbolIcon Symbol="Info24" FontSize="13"/>
                                                        </ui:Button>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- date lane, aligned like the main table -->
                                                <TextBlock Grid.Column="3" Text="{Binding PublishDateText}" FontSize="12"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0"
                                                           Style="{StaticResource TabularNumberText}"
                                                           Visibility="{Binding HasPublishDate, Converter={StaticResource BoolToVisibility}}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                                                <!-- Same fixed-column reasoning as the main row's version lane above
                                                     (a Grid does not clip per column, so an unbounded long version
                                                     here would bleed left over the name text instead of being
                                                     trimmed) and the same fix: a centred StackPanel put the arrow at
                                                     a different X per row depending on which children were visible,
                                                     and only the arrow had VerticalAlignment="Center" so it sat
                                                     lower than the stretched text either side. No
                                                     changelog column here, sub-rows never show one. -->
                                                <!-- One tooltip for the whole lane, same as the
                                                     main row's version lane above. -->
                                                <Grid x:Name="ChildVersionLane" Grid.Column="4" Width="138"
                                                      VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"
                                                      Background="Transparent"
                                                      ToolTip="{Binding VersionChangeTooltip}"
                                                      Visibility="{Binding HasVersions, Converter={StaticResource BoolToVisibility}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="62"/>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="62"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding InstalledVersion}" FontSize="13"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                               TextAlignment="Right"
                                                               Style="{StaticResource TabularNumberText}"
                                                               Visibility="{Binding HasInstalledVersion, Converter={StaticResource BoolToVisibility}}"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="→" FontSize="13"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding HasInstalledVersion, Converter={StaticResource BoolToVisibility}}"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <!-- Same no-installed-version centring as the flat
                                                         table's own version lane, spanning all 3 columns
                                                         here (no changelog lane in a sub-row). -->
                                                    <TextBlock Text="{Binding AvailableVersion}" FontSize="13" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TabularNumberText}">
                                                                <Setter Property="Grid.Column" Value="2"/>
                                                                <Setter Property="TextAlignment" Value="Left"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasInstalledVersion}" Value="False">
                                                                        <Setter Property="Grid.Column" Value="0"/>
                                                                        <Setter Property="Grid.ColumnSpan" Value="3"/>
                                                                        <Setter Property="TextAlignment" Value="Center"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                          </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Manual-open rows (a store, a launcher, no install this app can do, and per
                     HideManualNumbers no real values to show anyway): gathered here instead of sitting
                     full-height inside their category group with blank cells. A second, independent
                     ListCollectionView over the SAME _visible collection (MainViewModel.ManualOnlyView)
                     with its own Filter/SortDescriptions, set ONCE at construction, NOT a
                     GroupStyleSelector (WPF calls one with group=null in this configuration), and
                     the main ListBox/UpdatesView's own grouping, sorting and the diff-preserving
                     _visible/SyncVisible mechanics above are untouched by this. -->
                <StackPanel Margin="12,10,26,4"
                            Visibility="{Binding HasManualOnlyResults, Converter={StaticResource BoolToVisibility}}">
                    <Border Height="1" Margin="0,0,0,10" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>
                    <TextBlock Text="{Binding Loc[ManualUpdatesSectionTitle]}" FontSize="12" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                    <!-- No own capped ScrollViewer any more, this rolls with the table
                         in the ONE shared outer ScrollViewer above. ScrollViewer.HorizontalScrollBarVisibility
                         "Disabled" is what makes the WrapPanel below wrap at all: a ListBox's own template
                         ScrollViewer defaults to Auto, which measures its content at infinite width and
                         never wraps, VerticalScrollBarVisibility is disabled the same way so this ListBox's
                         own template does not open a second, nested scroll area. -->
                    <ListBox x:Name="ManualOpenListBox" ItemsSource="{Binding ManualOnlyView}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             PreviewKeyDown="OnUpdatesListPreviewKeyDown">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel x:Name="ManualOpenWrapPanel" Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,8,8"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue"/>
                                <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Root" CornerRadius="8" Padding="8,6"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background"
                                                            Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="Root" Property="Background"
                                                            Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                                    <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSnoozed}" Value="True">
                                                    <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <!-- Same shared RowActionsMenu as the main table's row menu, every
                                     item a compact row could plausibly need already gates itself via
                                     Visibility, so reuse rather than a second, drifting copy. -->
                                <Setter Property="ContextMenu" Value="{StaticResource RowActionsMenu}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Name}"
                                            AutomationProperties.Name="{Binding Name}">
                                    <Grid Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,7,0">
                                        <Border CornerRadius="4" Background="{Binding InitialBrush}"
                                                Visibility="{Binding UsesTile, Converter={StaticResource BoolToVisibility}}">
                                            <Grid>
                                                <TextBlock Text="{Binding InitialLetter}" FontSize="10" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TileGlyphBrush}"
                                                           Visibility="{Binding UsesLetterTile, Converter={StaticResource BoolToVisibility}}"/>
                                                <ui:SymbolIcon FontSize="11" Symbol="Box24" Foreground="{StaticResource TileGlyphBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding UsesGlyphTile, Converter={StaticResource BoolToVisibility}}"/>
                                                <Path Data="{Binding BrandGeometry}" Fill="{StaticResource TileGlyphBrush}" Stretch="Uniform"
                                                      Width="12" Height="12"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{Binding UsesBrandTile, Converter={StaticResource BoolToVisibility}}"/>
                                            </Grid>
                                        </Border>
                                        <Image Source="{Binding Icon}" Width="20" Height="20"/>
                                    </Grid>

                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                               MaxWidth="170" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                    <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                            Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding CriticalLabel}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                    </Border>

                                    <ui:Button Margin="6,0,0,0" Padding="3" Appearance="Transparent"
                                               Command="{Binding ShowChangelogCommand}"
                                               ToolTip="{Binding ChangelogHeader}"
                                               AutomationProperties.Name="{Binding ChangelogHeader}"
                                               Visibility="{Binding HasChangelog, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <ui:SymbolIcon Symbol="Info24" FontSize="12"
                                                           Visibility="{Binding ShowChangelogIcon, Converter={StaticResource BoolToVisibility}}"/>
                                            <views:WaitSpinner Visibility="{Binding IsChangelogLoading, Converter={StaticResource BoolToVisibility}}"/>
                                        </Grid>
                                    </ui:Button>

                                    <ui:Button Margin="4,0,0,0" Padding="3,2" Appearance="Secondary" FontSize="11"
                                               Content="{Binding OpenHeader}" Command="{Binding OpenCommand}"
                                               ToolTip="{Binding OpenTargetHeader}"
                                               Visibility="{Binding ShowOpenButton, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>
        </Grid>

        <!-- Action bar: sources checked on the left, what happens next on the right.
             Not a Grid with Column 1 (the buttons) at Width="Auto", a Grid measures an Auto
             column at effectively infinite width to find its natural size, so a long selection summary
             plus all three buttons just overflowed past the window at 200% text scale + minimum width
             ("Auswahl aktualisieren" cut off mid-word), with nothing wrapping. Fixed the same way as the
             toolbar above: DockPanel, with the INHERENTLY BOUNDED side (the fixed small set of buttons)
             docked, and the side that can genuinely vary in width (the pill list, anywhere from zero to
             a dozen sources) as LastChildFill, so IT wraps against the real remaining width instead of
             the buttons doing so against an unbounded one. -->
        <Border Grid.Row="7" Margin="24,16,24,20">
            <DockPanel LastChildFill="True">
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Only the "x selected · N MB" part remains; the "nothing selected" words are gone
                         and the text hides entirely when nothing is picked. -->
                    <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ui:Button Content="{Binding Loc[InstallSelectedButton]}" Appearance="Primary"
                               Padding="16,8"
                               Command="{Binding InstallSelectedCommand}"
                               ToolTip="{Binding Loc[InstallSelectedButton], Converter={StaticResource ShortcutTooltip}, ConverterParameter=InstallSelectedButton}"
                               IsEnabled="{Binding CanInstallSelected}"/>
                </WrapPanel>

                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <!-- One flat wrapping row of pills, no category headers. Each pill
                         sizes to its own content. -->
                    <ItemsControl ItemsSource="{Binding PillView}"
                                  ItemTemplate="{StaticResource SourcePillTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
