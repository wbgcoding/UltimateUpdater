<UserControl x:Class="UltimateUpdater.Views.Main.UpdateBanners"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:UltimateUpdater.Views.Behaviors">
    <StackPanel>
    <!-- Self-update offer: a quiet banner, never a modal. Built by hand because ui:InfoBar's template does
         not present its Content here, which would leave no way to accept the update. -->
    <Border Margin="24,0,24,8" Padding="14,10"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8"
            behaviors:GlassCardHighlight.Show="True"
            Visibility="{Binding SelfUpdateAvailable, Converter={StaticResource BoolToVisibility}}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:SymbolIcon Grid.Column="0" Symbol="ArrowDownload24" FontSize="18" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <!-- A Grid, not a horizontal StackPanel: that panel gives its children unlimited width, so the
                 ellipsis could never appear and a long title would push the version out of view. Here the
                 title takes what is left and trims; the version always fits. -->
            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- While a verified download waits for running work, the title says so instead. -->
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource EmptyToNull}}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding Loc[SelfUpdateTitle]}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelfUpdateWaitingForWork}" Value="True">
                                    <Setter Property="Text" Value="{Binding Loc[SelfUpdateWaitingForWork]}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding SelfUpdateVersion}" Margin="8,0,0,0" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Grid>

            <!-- Progress of the running update: phase with percentage, a bar, and bytes with speed. -->
            <StackPanel Margin="0,6,0,0"
                        Visibility="{Binding SelfUpdateShowsProgress, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding SelfUpdatePhaseText}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               AutomationProperties.AutomationId="SelfUpdatePhaseText"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelfUpdateDetail}" ToolTip="{Binding SelfUpdateDetail, Converter={StaticResource EmptyToNull}}" Margin="12,0,0,0"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               AutomationProperties.AutomationId="SelfUpdateDetail"/>
                </Grid>
                <ProgressBar Margin="0,4,0,0" Height="4" Minimum="0" Maximum="100"
                             Value="{Binding SelfUpdatePercent, Mode=OneWay}"
                             IsIndeterminate="{Binding SelfUpdateProgressIndeterminate}"
                             AutomationProperties.AutomationId="SelfUpdateProgressBar"
                             AutomationProperties.Name="{Binding SelfUpdatePhaseText}"/>
            </StackPanel>
            </StackPanel>

            <ui:Button Grid.Column="2" Content="{Binding Loc[SelfUpdateWhatsNew]}" Appearance="Secondary"
                       Margin="0,0,8,0" Command="{Binding ShowSelfUpdateChangelogCommand}"/>

            <!-- The hint only explains the busy case; a click already running the update disables the button too, with nothing to wait for. -->
            <ui:Button Grid.Column="3" Content="{Binding Loc[SelfUpdateInstall]}" Appearance="Primary"
                       Command="{Binding InstallSelfUpdateCommand}"
                       ToolTipService.ShowOnDisabled="True">
                <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                <Setter Property="ToolTip" Value="{Binding Loc[SelfUpdateBusyHint]}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCleanupRunning}" Value="True">
                                <Setter Property="ToolTip" Value="{Binding Loc[SelfUpdateBusyHint]}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>

            <ui:Button Grid.Column="4" Content="{Binding Loc[CancelButton]}" Appearance="Secondary" Margin="8,0,0,0"
                       Command="{Binding CancelSelfUpdateCommand}"
                       Visibility="{Binding SelfUpdateCanCancel, Converter={StaticResource BoolToVisibility}}"/>

            <ui:Button Grid.Column="5" Appearance="Secondary" Margin="8,0,0,0" Padding="9,6"
                       Command="{Binding DismissSelfUpdateCommand}"
                       ToolTip="{Binding SelfUpdateDismissLabel}"
                       AutomationProperties.Name="{Binding SelfUpdateDismissLabel}">
                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
            </ui:Button>
        </Grid>
    </Border>

    <!-- "Installed, reboot pending" notice after a batch (winget 3010/1641). Information, not a
         failure, the updates did apply. -->
    <Border Margin="24,0,24,8" Padding="14,10"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8"
            behaviors:GlassCardHighlight.Show="True"
            Visibility="{Binding RebootRequiredNotice, Converter={StaticResource BoolToVisibility}}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Grid.Column="0" Symbol="ArrowClockwise24" FontSize="18" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding RebootInfoText}" Margin="12,0,12,0"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <ui:Button Grid.Column="2" Appearance="Secondary" Padding="9,6"
                       Command="{Binding DismissRebootNoticeCommand}"
                       ToolTip="{Binding Loc[SelfUpdateDismiss]}"
                       AutomationProperties.Name="{Binding Loc[SelfUpdateDismiss]}">
                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
            </ui:Button>
        </Grid>
    </Border>

    <!-- A quiet nudge when the last cleanup was long ago. Same Border style and the same
         hand-built dismiss idea as the two banners above; the x's first click swaps the row for an
         in-place "only this time"/"never again" fork instead of a dialog or a toast. -->
    <Border Margin="24,0,24,8" Padding="14,10"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8"
            behaviors:GlassCardHighlight.Show="True"
            Visibility="{Binding CleanupReminderVisible, Converter={StaticResource BoolToVisibility}}">
        <Grid>
            <Grid Visibility="{Binding CleanupReminderOfferVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="Broom24" FontSize="18" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <TextBlock Grid.Column="1" Text="{Binding CleanupReminderText}" Margin="12,0,12,0"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <ui:Button Grid.Column="2" Content="{Binding Loc[CleanupTitle]}" Appearance="Primary"
                           Command="{Binding ShowCleanupCommand}"/>

                <ui:Button Grid.Column="3" Appearance="Secondary" Margin="8,0,0,0" Padding="9,6"
                           Command="{Binding DismissCleanupReminderCommand}"
                           ToolTip="{Binding Loc[SelfUpdateDismiss]}"
                           AutomationProperties.Name="{Binding Loc[SelfUpdateDismiss]}">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                </ui:Button>
            </Grid>

            <!-- Asks once, in place: the x's first click gets here instead of a dialog or a toast. -->
            <Grid Visibility="{Binding CleanupReminderAsking, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="1" Content="{Binding Loc[CleanupReminderThisTime]}" Appearance="Secondary"
                           Margin="0,0,8,0" Command="{Binding DismissCleanupReminderOnceCommand}"/>
                <ui:Button Grid.Column="2" Content="{Binding Loc[CleanupReminderNeverAgain]}" Appearance="Secondary"
                           Command="{Binding DismissCleanupReminderForeverCommand}"/>
            </Grid>
        </Grid>
    </Border>
    </StackPanel>
</UserControl>
