<UserControl x:Class="UltimateUpdater.Views.Main.ScanStatusStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:UltimateUpdater.Views">
    <!-- One-line status strip, full width, directly above the table: names why the rows on screen
         are what they are (a cached result from last session, or a scan that found no connection at
         all). Same muted-surface style as the install/queue band above it, no red, no icon beyond the
         app's ordinary hint glyph. Collapsed (no reserved row height) when neither case applies; when
         both do, the connection banner explains the cached one too, so it wins. -->
    <Border x:Name="ScanStatusBanner" Margin="24,0,24,8" Padding="12,7" CornerRadius="8"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasCachedResult}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasConnectionBanner}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:SymbolIcon Grid.Column="0" Symbol="Info24" FontSize="14" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <!-- A Grid star column, not a horizontal StackPanel: a StackPanel measures its children at
                 infinite width, which silently defeats TextTrimming on the one long enough to need it. -->
            <TextBlock x:Name="ScanStatusBannerText" Grid.Column="1" Margin="8,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource EmptyToNull}}"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding CachedResultAgeText}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasConnectionBanner}" Value="True">
                                <Setter Property="Text" Value="{Binding OfflineBannerText}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
