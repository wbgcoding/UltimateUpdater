<ui:FluentWindow x:Class="UltimateUpdater.Views.Popups.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding WindowTitle}"
        Width="600" MinHeight="220" MinWidth="420"
        SizeToContent="Height" MaxHeight="520"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        FocusManager.FocusedElement="{Binding ElementName=CloseButton}">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- title bar -->
            <RowDefinition Height="Auto"/>   <!-- name + version -->
            <RowDefinition Height="Auto"/>   <!-- changelog text -->
            <RowDefinition Height="Auto"/>   <!-- actions -->
        </Grid.RowDefinitions>

        <!-- Same as ErrorDetailWindow: a ui:TitleBar hard-truncates instead of wrapping,
             and the item name is already shown big in the body below, so the bar itself only needs the
             short generic title; the combined WindowTitle stays on Window.Title for the taskbar. -->
        <ui:TitleBar Grid.Row="0" Title="{Binding Loc[ChangelogTitle]}" FontSize="16" FontWeight="SemiBold">
            <ui:TitleBar.Icon>
                <!-- Assembly-qualified like MainWindow's so it resolves whichever assembly is
                     the entry point -->
                <ui:ImageIcon Style="{StaticResource TitleBarAppIcon}" Source="pack://application:,,,/UltimateUpdater;component/Assets/icon.png"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="20,4,20,10">
            <!-- Grid, not a horizontal StackPanel: a StackPanel measures its children with infinite
                 width, so TextTrimming never engaged and a long name was simply cut off mid-letter
                 (same fix as MainWindow's row-name column / ErrorDetailWindow). -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" Symbol="DocumentText24" FontSize="18" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0"
                           VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Name}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Grid>
            <TextBlock Text="{Binding VersionText}" FontSize="12" Margin="26,2,0,0"
                       Visibility="{Binding HasVersionText, Converter={StaticResource BoolToVisibility}}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- The changelog text, selectable and read-only, same surface treatment as the error-detail dialog. The
             window only opens when there is text, so the Visibility binding is a defensive fallback. -->
        <Border Grid.Row="2" BorderThickness="0,1,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}">
            <!-- Visible, not Auto, so the scrollbar is shown from the start. WPF-UI's implicit TextBox style
                 hosts an overlay scrollbar that stays invisible whatever VerticalScrollBarVisibility says.
                 Style="{x:Null}" reverts the whole control to the framework's default style and template
                 together; clearing only the Template leaves the style's other setters fighting a template they no
                 longer match and blanks the text. Same idea as MainWindow's Style="{x:Null}" on a ScrollViewer,
                 applied at the control level because there is no ScrollViewer element here. -->
            <TextBox x:Name="ChangelogTextBox" Style="{x:Null}" Text="{Binding Text, Mode=OneWay}"
                     IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     FontSize="13" TextWrapping="Wrap" MaxHeight="350"
                     VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent" BorderThickness="0" Padding="20,12"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     AutomationProperties.Name="{Binding WindowTitle}">
                <!-- The text box's built-in menu is an internal subclass of ContextMenu, which an implicit
                     style never reaches, so it would stay grey. A read-only text needs only these two. -->
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding Loc[TextMenuCopy]}" Command="ApplicationCommands.Copy"
                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="{Binding Loc[TextMenuSelectAll]}" Command="ApplicationCommands.SelectAll"
                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>
        </Border>

        <Grid x:Name="ChangelogActionRow" Grid.Row="3" Margin="20,12,20,20">
            <ui:Button Command="{Binding OpenReleaseCommand}" HorizontalAlignment="Left"
                       Icon="{ui:SymbolIcon Open24}"
                       Content="{Binding Loc[ChangelogOpenRelease]}"
                       Visibility="{Binding HasUrl, Converter={StaticResource BoolToVisibility}}"/>
            <ui:Button x:Name="CloseButton" Click="OnCloseClicked" Appearance="Primary" HorizontalAlignment="Right" IsDefault="True"
                       Content="{Binding Loc[InstallProgressClose]}"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
