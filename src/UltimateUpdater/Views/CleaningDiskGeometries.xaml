<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The cleaning drive's own 24x24 geometry: a hard disk seen from above (body with corner screws,
         platter, spindle hub, actuator arm on its pivot). Shared between the cleanup dialog's centre
         animation (CleanupWindow.xaml) and the main toolbar's cleanup button, which shows the same drive
         while a cleanup runs; the toolbar inlines the same path data. Every part keeps a clear gap to its
         neighbours, so the drawing still reads at toolbar size instead of running together. -->
    <Geometry x:Key="CleaningDriveBodyOutlineGeometry">M4.8 2 L19.2 2 A1.8,1.8 0 0 1 21 3.8 L21 20.2 A1.8,1.8 0 0 1 19.2 22 L4.8 22 A1.8,1.8 0 0 1 3 20.2 L3 3.8 A1.8,1.8 0 0 1 4.8 2 Z</Geometry>

    <Geometry x:Key="CleaningDriveScrewHolesGeometry">M5.65 3.95 A0.7,0.7 0 1 1 4.25 3.95 A0.7,0.7 0 1 1 5.65 3.95 Z M19.75 3.95 A0.7,0.7 0 1 1 18.35 3.95 A0.7,0.7 0 1 1 19.75 3.95 Z M5.65 20.05 A0.7,0.7 0 1 1 4.25 20.05 A0.7,0.7 0 1 1 5.65 20.05 Z M19.75 20.05 A0.7,0.7 0 1 1 18.35 20.05 A0.7,0.7 0 1 1 19.75 20.05 Z</Geometry>

    <Geometry x:Key="CleaningDrivePlatterDiscGeometry">M18.8 10.2 A6.8,6.8 0 1 1 5.2 10.2 A6.8,6.8 0 1 1 18.8 10.2 Z</Geometry>

    <Geometry x:Key="CleaningDriveHubGeometry">M13.8 10.2 A1.8,1.8 0 1 1 10.2 10.2 A1.8,1.8 0 1 1 13.8 10.2 Z</Geometry>

    <Geometry x:Key="CleaningDriveHubDotGeometry">M12.65 10.2 A0.65,0.65 0 1 1 11.35 10.2 A0.65,0.65 0 1 1 12.65 10.2 Z</Geometry>

    <!-- Arm, read head and pivot overlap, so the nonzero fill rule (F1) paints them as one shape. -->
    <Geometry x:Key="CleaningDriveArmGeometry">F1 M17.468 18.558 L14.978 14.406 L14.222 14.794 L16.132 19.242 Z M15.201 14.293 L14.632 13.18 L13.43 13.795 L13.999 14.907 Z M18.3 18.9 A1.5,1.5 0 1 1 15.3 18.9 A1.5,1.5 0 1 1 18.3 18.9 Z</Geometry>

    <Geometry x:Key="CleaningDrivePivotDotGeometry">M17.3 18.9 A0.5,0.5 0 1 1 16.3 18.9 A0.5,0.5 0 1 1 17.3 18.9 Z</Geometry>
</ResourceDictionary>
