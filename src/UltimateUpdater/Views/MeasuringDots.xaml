<UserControl x:Class="UltimateUpdater.Views.MeasuringDots"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsHitTestVisible="False"
             AutomationProperties.AutomationId="MeasuringDots">
    <!-- "Still measuring", said as motion instead of as a static "…". Three dots fade up
         and down one after the other on one shared period, so they read as a single indicator rather than
         three blinking things.

         Opacity ONLY, no transform, no size change, so a list of a dozen of these costs one render pass
         and no layout pass at all, and the storyboard is capped at 60 fps like every other animation here.

         Started and stopped from the code-behind rather than from a Style trigger: a Setter inside a Style
         cannot carry Storyboard.TargetName, and the dots have to be addressed by name. -->
    <UserControl.Resources>
        <Storyboard x:Key="PulseStoryboard" Timeline.DesiredFrameRate="60" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1"
                                           Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                <LinearDoubleKeyFrame Value="0.25" KeyTime="0:0:0"/>
                <LinearDoubleKeyFrame Value="1.0" KeyTime="0:0:0.2"/>
                <LinearDoubleKeyFrame Value="0.25" KeyTime="0:0:0.6"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2"
                                           Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                <LinearDoubleKeyFrame Value="0.25" KeyTime="0:0:0.2"/>
                <LinearDoubleKeyFrame Value="1.0" KeyTime="0:0:0.4"/>
                <LinearDoubleKeyFrame Value="0.25" KeyTime="0:0:0.8"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3"
                                           Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                <LinearDoubleKeyFrame Value="0.25" KeyTime="0:0:0.4"/>
                <LinearDoubleKeyFrame Value="1.0" KeyTime="0:0:0.6"/>
                <LinearDoubleKeyFrame Value="0.25" KeyTime="0:0:1.0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel.Resources>
            <Style TargetType="Ellipse">
                <Setter Property="Width" Value="5"/>
                <Setter Property="Height" Value="5"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                <Setter Property="Opacity" Value="0.25"/>
            </Style>
        </StackPanel.Resources>

        <Ellipse x:Name="Dot1"/>
        <Ellipse x:Name="Dot2"/>
        <Ellipse x:Name="Dot3"/>
    </StackPanel>
</UserControl>
