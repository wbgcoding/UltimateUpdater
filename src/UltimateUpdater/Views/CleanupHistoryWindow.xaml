<ui:FluentWindow x:Class="UltimateUpdater.Views.CleanupHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:UltimateUpdater.Views"
        Title="{Binding Loc[CleanupHistoryTitle]}"
        Width="760" MinWidth="560" MinHeight="420"
        SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <!-- A knob for the past mixed in with the controls for what can be cleaned right now reads as one
         more thing to scroll past, so history gets its own window, opened from a button in the cleanup
         dialog's header band, same pattern as HistoryWindow for the update history. DataContext is the
         SAME CleanupViewModel instance the cleanup dialog already owns, this window adds no view model
         of its own, it only shows a slice of one that already exists and stays live for as long as the
         app runs. -->
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Loc[CleanupHistoryTitle]}" FontSize="16" FontWeight="SemiBold">
            <ui:TitleBar.Icon>
                <!-- Assembly-qualified like MainWindow's so it resolves whichever assembly is
                     the entry point -->
                <ui:ImageIcon Style="{StaticResource TitleBarAppIcon}" Source="pack://application:,,,/UltimateUpdater;component/Assets/icon.png"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Everything freed across every run still on record, computed fresh in
             CleanupViewModel.History.cs from the rows already held, nothing new persisted for this.
             Hidden along with the rest of the window's history-only content when there is no history. -->
        <Border Grid.Row="1" Margin="16,0,16,12" CornerRadius="8" BorderThickness="1"
                Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding HistoryTotalFreedText}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <!-- Label and value lines; the labels share one column width so the values line up. -->
                    <ItemsControl ItemsSource="{Binding HistoryStats}" Margin="0,8,0,0"
                                  Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="StatLabel"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" Margin="0,0,16,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- A history of runs that all found nothing has no areas to draw, so the calm
                         sentence takes the chart's place instead. -->
                    <TextBlock Text="{Binding HistoryEmptyOverviewText}" FontSize="12" Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasNotFreedAnything, Converter={StaticResource BoolToVisibility}}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <!-- Every area summed over all runs: the six biggest as blue slices, the rest as one grey
                     one. Legend lines carry the same tooltip as the slices. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding HasFreedAnything, Converter={StaticResource BoolToVisibility}}">
                    <local:PieChart Slices="{Binding HistorySlices}"
                                    NeutralFill="{DynamicResource TextFillColorDisabledBrush}"/>
                    <ItemsControl ItemsSource="{Binding HistorySlices}" Margin="16,0,0,0" VerticalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2" Background="Transparent"
                                      ToolTip="{Binding ToolTipText}"
                                      AutomationProperties.Name="{Binding ToolTipText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{Binding Shade}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOther}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" MaxWidth="190"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PercentText}" FontSize="12" Margin="12,0,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bulk delete gets its own row rather than sharing the TitleBar row, that row is WPF-UI's
             own caption-button territory (same reasoning as the cleanup dialog's history button). -->
        <Grid Grid.Row="2" Margin="16,0,16,4"
              Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
            <ui:Button HorizontalAlignment="Right" Appearance="Secondary" Padding="10,6"
                       Click="OnClearAll"
                       Content="{Binding Loc[CleanupHistoryClearAll]}"
                       ToolTip="{Binding Loc[CleanupHistoryClearAll]}"
                       AutomationProperties.Name="{Binding Loc[CleanupHistoryClearAll]}">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24" FontSize="16"/></ui:Button.Icon>
            </ui:Button>
        </Grid>

        <ScrollViewer x:Name="CleanupHistoryList" Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl Grid.IsSharedSizeScope="True" ItemsSource="{Binding History}" Margin="16,4,16,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Margin="0,4" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Expander.Header>
                                <!-- Date and freed size each keep a shared column width across every row
                                     (SharedSizeGroup, scoped by the ItemsControl above), so the rows line
                                     up instead of drifting with whatever that one row's own text needs. -->
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="HistoryDate"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="HistoryFreed"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding WhenText}" FontSize="13"
                                               Margin="0,0,16,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SummaryText}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <!-- A stopped run freed what it freed and no more. -->
                                        <TextBlock Text="{Binding StoppedText}" FontSize="11"
                                                   Visibility="{Binding WasStopped, Converter={StaticResource BoolToVisibility}}"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding FreedText}" FontSize="13"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" TextAlignment="Right"
                                               Margin="12,0,8,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                    <!-- One row's own delete, no confirmation (see DeleteCommand's own
                                         comment), small and quiet, Dismiss rather than a trash can, same
                                         language MainWindow already uses for a row-level remove. Right
                                         margin keeps it clear of WPF-UI's own default chevron, which this
                                         unstyled Expander draws past the header content's own right edge. -->
                                    <ui:Button Grid.Column="3" Appearance="Transparent" Padding="6"
                                               Margin="0,0,28,0"
                                               VerticalAlignment="Center"
                                               Command="{Binding DeleteCommand}"
                                               ToolTip="{Binding DeleteTooltip}"
                                               AutomationProperties.Name="{Binding DeleteTooltip}">
                                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="14"/>
                                    </ui:Button>
                                </Grid>
                            </Expander.Header>

                            <ItemsControl ItemsSource="{Binding Areas}" Margin="26,4,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,8,0">
                                                <TextBlock Text="{Binding SkippedText}" FontSize="11"
                                                           Margin="0,0,10,0" VerticalAlignment="Center"
                                                           Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVisibility}}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <!-- An area that was not done says why, muted, instead of a "0,0 B" freed figure. -->
                                                <TextBlock Text="{Binding NoteText}" FontSize="11"
                                                           Margin="0,0,10,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsNotDone, Converter={StaticResource BoolToVisibility}}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Text="{Binding FreedText}" FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding ShowsFreed, Converter={StaticResource BoolToVisibility}}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state: the header button that opens this window only shows once HasHistory is true, so
             this is unreachable through normal use today, kept anyway (same convention HistoryWindow
             uses for its own empty state) for whatever later opens this window some other way. -->
        <StackPanel x:Name="CleanupHistoryEmptyState" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"
                    Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVisibility}}">
            <ui:SymbolIcon Symbol="History24" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            <TextBlock Text="{Binding Loc[CleanupHistoryEmpty]}" Margin="0,12,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
